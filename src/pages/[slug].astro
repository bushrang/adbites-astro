---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import { sanityClient } from "../lib/sanity";
import {
    GROQ_ALL_SERVICE_SLUGS,
    GROQ_SERVICE_BY_SLUG,
} from "../lib/sanityQueries";
import { PortableText } from "astro-portabletext";
import CaseStudiesSection from "../components/CaseStudiesSection.astro";
import FaqSection from "../components/FaqSection.astro";
import CaseStudySpotlight from "../components/CaseStudySpotlight.astro";
import ExpertiseGrid from "../components/ExpertiseGrid.astro";
import MetaAdsShowcase from "../components/MetaAdsShowcase.astro";

export const prerender = true;

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(GROQ_ALL_SERVICE_SLUGS);
    return slugs.map((slug: string) => ({
        params: { slug },
    }));
}

const { slug } = Astro.params;
const service = await sanityClient.fetch(GROQ_SERVICE_BY_SLUG, { slug });

if (service?.spotlightCaseStudy) {
    console.log(
        "DEBUG: Spotlight Data",
        JSON.stringify(service.spotlightCaseStudy, null, 2),
    );
}

if (!service) {
    return Astro.redirect("/404");
}

const { title, seo, hero, content, kpis, focus, managedBy, caseStudies } =
    service;

const faqSchema = service.faqs
    ? {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          mainEntity: service.faqs.map((faq: any) => ({
              "@type": "Question",
              name: faq.question,
              acceptedAnswer: {
                  "@type": "Answer",
                  text: faq.answer,
              },
          })),
      }
    : null;

const schemaGraph = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Service",
            "@id": `https://www.adbites.de/${slug}/#service`,
            serviceType: title,
            name: title,
            provider: { "@id": "https://www.adbites.de/#organization" },
            areaServed: ["DE", "AT", "CH"],
            hasOfferCatalog: {
                "@type": "OfferCatalog",
                name: `${title} Services`,
                itemListElement: [
                    {
                        "@type": "Offer",
                        itemOffered: {
                            "@type": "Service",
                            name: "Store Visit Optimization",
                        },
                    },
                    {
                        "@type": "Offer",
                        itemOffered: {
                            "@type": "Service",
                            name: "Server-Side Tracking Setup",
                        },
                    },
                ],
            },
            mainEntityOfPage: {
                "@id": `https://www.adbites.de/${slug}/`,
            },
        },
        ...(faqSchema ? [faqSchema] : []),
        {
            "@type": "BreadcrumbList",
            itemListElement: [
                {
                    "@type": "ListItem",
                    position: 1,
                    name: "Home",
                    item: "https://adbites.de",
                },
                {
                    "@type": "ListItem",
                    position: 2,
                    name: "Services",
                    item: "https://adbites.de/services",
                },
                {
                    "@type": "ListItem",
                    position: 3,
                    name: title,
                    item: `https://adbites.de/${slug}`,
                },
            ],
        },
    ],
};
---

<Layout
    title={seo?.metaTitle || title + " - Adbites Agentur"}
    description={seo?.metaDescription}
>
    <!-- JSON-LD Injection -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <main class="bg-brand-dark min-h-screen text-white">
        {/* Hero Section */}
        <section class="relative pt-32 pb-20 px-6 overflow-hidden">
            {
                hero?.bgImageUrl && (
                    <div class="absolute inset-0 z-0">
                        <img
                            src={hero.bgImageUrl}
                            alt=""
                            class="w-full h-full object-cover opacity-20 blur-sm"
                        />
                        <div class="absolute inset-0 bg-gradient-to-b from-brand-dark/80 to-brand-dark" />
                    </div>
                )
            }

            {/* Hero Glow */}
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] bg-brand-primary/20 blur-[120px] rounded-full pointer-events-none z-0"
            >
            </div>

            <div class="relative z-10 max-w-4xl mx-auto text-center">
                <div class="flex flex-wrap justify-center gap-3 mb-6">
                    <span
                        class="inline-block py-1 px-3 rounded-full bg-brand-primary/10 border border-brand-primary/20 text-brand-primary text-sm font-bold"
                    >
                        {service.category || "Service"}
                    </span>
                    {
                        focus && (
                            <span class="inline-block py-1 px-3 rounded-full bg-white/5 border border-white/10 text-gray-300 text-sm">
                                Focus: {focus}
                            </span>
                        )
                    }
                </div>

                <h1 class="text-4xl md:text-6xl font-bold mb-6 leading-[1.1]">
                    {hero?.headline || title}
                </h1>
                {
                    hero?.subline && (
                        <p class="text-lg md:text-xl text-white max-w-2xl mx-auto leading-relaxed mb-8">
                            {hero.subline}
                        </p>
                    )
                }

                <a
                    href="#contact"
                    class="inline-block bg-brand-primary text-white font-bold py-4 px-8 rounded-full hover:scale-105 transition-transform shadow-[0_0_20px_rgba(255,107,0,0.4)] mb-12"
                >
                    Jetzt Strategie-Gespräch vereinbaren
                </a>

                {/* Trust Signals */}
                <div
                    class="flex flex-wrap justify-center gap-4 text-sm text-gray-300"
                >
                    <div
                        class="flex items-center gap-2 bg-gradient-to-r from-brand-primary/10 to-brand-accent/10 border border-brand-primary/20 px-4 py-2 rounded-full backdrop-blur-md hover:from-brand-primary/20 hover:to-brand-accent/20 transition-all shadow-lg shadow-brand-primary/5"
                    >
                        <svg
                            class="w-4 h-4 text-brand-primary flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="font-medium text-white/90"
                            >Über 4,2 Mio. € Werbebudget verwaltet</span
                        >
                    </div>

                    <div
                        class="flex items-center gap-2 bg-gradient-to-r from-brand-primary/10 to-brand-accent/10 border border-brand-primary/20 px-4 py-2 rounded-full backdrop-blur-md hover:from-brand-primary/20 hover:to-brand-accent/20 transition-all shadow-lg shadow-brand-primary/5"
                    >
                        <svg
                            class="w-4 h-4 text-brand-primary flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="font-medium text-white/90"
                            >Spezialisiert auf stationären Einzelhandel seit
                            2007</span
                        >
                    </div>

                    <div
                        class="flex items-center gap-2 bg-gradient-to-r from-brand-primary/10 to-brand-accent/10 border border-brand-primary/20 px-4 py-2 rounded-full backdrop-blur-md hover:from-brand-primary/20 hover:to-brand-accent/20 transition-all shadow-lg shadow-brand-primary/5"
                    >
                        <svg
                            class="w-4 h-4 text-brand-primary flex-shrink-0"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 13l4 4L19 7"></path>
                        </svg>
                        <span class="font-medium text-white/90"
                            >Partner von HolzLand, EK Retail und weiteren
                            Verbundgruppen</span
                        >
                    </div>
                </div>
            </div>
        </section>

        {/* Meta Ads Showcase - ONLY for Meta Ads service */}
        {slug === "meta-ads-agentur" && <MetaAdsShowcase />}

        {/* Content Section */}
        <section class="py-16 px-6">
            <div
                class="max-w-3xl mx-auto prose prose-invert prose-lg prose-headings:font-bold prose-headings:text-white prose-a:text-brand-primary hover:prose-a:text-brand-accent prose-p:text-gray-300 prose-li:text-gray-300"
            >
                {
                    content ? (
                        <PortableText value={content} />
                    ) : (
                        <p>Inhalt folgt...</p>
                    )
                }
            </div>
        </section>

        {/* Local Targeting / ARIA KI Section */}
        <ExpertiseGrid />

        {/* Case Study Spotlight (Deep Dive) */}
        {
            service.spotlightCaseStudy && (
                <CaseStudySpotlight data={service.spotlightCaseStudy} />
            )
        }

        {/* Case Studies Section (Grid) */}
        {caseStudies && <CaseStudiesSection data={caseStudies} />}

        {/* Expert Box (E-E-A-T) */}
        {
            managedBy && (
                <section class="py-16 px-6 bg-white/5 border-y border-white/10">
                    <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-8">
                        <div class="w-32 h-32 flex-shrink-0">
                            {managedBy.image ? (
                                <img
                                    src={managedBy.image}
                                    alt={managedBy.name}
                                    class="w-full h-full object-cover rounded-full border-2 border-brand-primary"
                                />
                            ) : (
                                <div class="w-full h-full bg-gray-700 rounded-full flex items-center justify-center text-3xl">
                                    👤
                                </div>
                            )}
                        </div>
                        <div class="flex-1 text-center md:text-left">
                            <h3 class="text-2xl font-bold text-white mb-2">
                                Ihr Strategie-Lead: {managedBy.name}
                            </h3>
                            <p class="text-brand-primary font-medium mb-4">
                                {managedBy.role || "Expert"}
                            </p>
                            <p class="text-gray-300 mb-6 max-w-2xl">
                                {managedBy.bio ||
                                    `Experte für ${title} mit Fokus auf ${focus || "Performance Marketing"}.`}
                            </p>

                            {managedBy.sameAs && (
                                <a
                                    href={managedBy.sameAs}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-sm text-gray-400 hover:text-white underline decoration-dotted"
                                >
                                    Zum Experten-Profil ↗
                                </a>
                            )}
                        </div>
                    </div>
                </section>
            )
        }

        {/* Technical Specs & Pricing Summary */}
        <section class="py-16 px-6">
            <div class="max-w-4xl mx-auto grid md:grid-cols-2 gap-8">
                {/* Specs */}
                {
                    service.technicalSpecs && (
                        <div class="bg-white/5 p-8 rounded-2xl border border-white/10">
                            <h3 class="text-xl font-bold mb-6 text-white border-b border-white/10 pb-2">
                                Technical Setup
                            </h3>
                            <div class="space-y-4">
                                <div>
                                    <span class="block text-xs uppercase tracking-widest text-gray-500 mb-1">
                                        Tools
                                    </span>
                                    <p class="text-gray-300">
                                        {service.technicalSpecs.frameworks ||
                                            "Custom Setup"}
                                    </p>
                                </div>
                                <div>
                                    <span class="block text-xs uppercase tracking-widest text-gray-500 mb-1">
                                        Deliverables
                                    </span>
                                    <p class="text-gray-300">
                                        {service.technicalSpecs.deliverables ||
                                            "Full Service Management"}
                                    </p>
                                </div>
                            </div>
                        </div>
                    )
                }

                {/* Pricing / ROI */}
                <div
                    class="bg-gradient-to-br from-brand-primary/10 to-brand-dark p-8 rounded-2xl border border-brand-primary/20 relative overflow-hidden group"
                >
                    <div
                        class="absolute top-0 right-0 w-32 h-32 bg-brand-primary/20 blur-3xl -mr-16 -mt-16 transition-opacity group-hover:opacity-100 opacity-50"
                    >
                    </div>

                    <h3
                        class="text-xl font-bold mb-6 text-white border-b border-white/10 pb-2"
                    >
                        Investment & Impact
                    </h3>
                    <div class="space-y-4 relative z-10">
                        <div class="flex justify-between items-center">
                            <span class="text-gray-400">Preis-Niveau</span>
                            <span class="font-mono text-brand-accent font-bold"
                                >{service.priceRange || "Custom"}</span
                            >
                        </div>
                        {
                            kpis?.roi && (
                                <div class="flex justify-between items-center">
                                    <span class="text-gray-400">
                                        Ø ROI (Retail)
                                    </span>
                                    <span class="font-mono text-green-400 font-bold">
                                        {kpis.roi}
                                    </span>
                                </div>
                            )
                        }
                        <p class="text-sm text-gray-400 mt-4 leading-relaxed">
                            Transparente Festpreise passend zum
                            Agentur-Ökosystem. Keine versteckten Gebühren.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        {/* FAQ Section */}
        {service.faqs && <FaqSection faqs={service.faqs} />}

        {/* CTA Repeater */}
        <section class="py-24 px-6 text-center" id="contact">
            <div class="max-w-3xl mx-auto">
                <h2 class="text-3xl font-bold mb-6">Ready to scale?</h2>
                <p class="text-xl text-gray-400 mb-8">
                    Lass uns darüber sprechen, wie {title} dein Business voranbringt.
                </p>
                <a
                    href="mailto:kontakt@adbites.de"
                    class="inline-block bg-brand-primary text-white font-bold py-4 px-8 rounded-full hover:scale-105 transition-transform shadow-[0_0_20px_rgba(255,107,0,0.4)]"
                >
                    Gespräch vereinbaren
                </a>
            </div>
        </section>
    </main></Layout
>
