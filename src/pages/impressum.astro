---
import Layout from "../layouts/Layout.astro";
import { sanityClient } from "../lib/sanity";
import { GROQ_ORGANIZATION, GROQ_LEGAL_PAGE_BY_SLUG } from "../lib/sanityQueries";
import { PortableText } from "astro-portabletext";

const organization = await sanityClient.fetch(GROQ_ORGANIZATION);
const pageData = await sanityClient.fetch(GROQ_LEGAL_PAGE_BY_SLUG, { slug: "impressum" });
---

<Layout title={`${pageData?.title || "Impressum"} | Adbites`}>
    <main class="bg-[#0d0101] min-h-screen text-slate-100 pt-32 pb-24 px-6">
        <div class="max-w-3xl mx-auto prose prose-invert prose-lg prose-headings:font-bold prose-headings:text-white prose-a:text-brand-primary hover:prose-a:text-brand-accent prose-p:text-gray-300">
            <h1>{pageData?.title || "Impressum"}</h1>
            
            {pageData?.content ? (
                <PortableText value={pageData.content} />
            ) : (
                <>
                    <div class="mb-8 p-4 bg-yellow-500/10 border border-yellow-500/30 text-yellow-500 rounded-lg text-sm font-medium">
                        Info: Diese Seite zeigt aktuell einen Platzhalter. Erstelle eine Seite vom Typ "Legal Pages" mit dem Slug "impressum" im Sanity Studio, um diese Texte dauerhaft zu überschreiben.
                    </div>
                    <h2>Angaben gemäß § 5 TMG</h2>
            <p>
                {organization?.name || "Adbites"}<br />
                {organization?.address?.streetAddress || "[Musterstraße]"}<br />
                {organization?.address?.postalCode || "[PLZ]"} {organization?.address?.addressLocality || "[Stadt]"}
            </p>

            <h2>Kontakt</h2>
            <p>
                Telefon: [Bitte eintragen]<br />
                E-Mail: {organization?.contactPoints?.[0]?.email || "hello@adbites.com"}
            </p>

            <h2>Umsatzsteuer-ID</h2>
            <p>
                Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz:<br />
                [DE 123 456 789]
            </p>
            
            <h2>Geschäftsführung</h2>
            <p>
                Vertreten durch: [Vorname Nachname]
            </p>

            <h2>Verbraucherstreitbeilegung/Universalschlichtungsstelle</h2>
            <p>
                Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
            </p>
                </>
            )}
        </div>
    </main>
</Layout>
