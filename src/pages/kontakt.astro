---
import Layout from "../layouts/Layout.astro";
import InteractiveContactForm from "../components/InteractiveContactForm.jsx";
---

<Layout title="Kontakt aufnehmen | Adbites Agentur">
    
    <main class="bg-brand-dark min-h-screen text-white pt-32 pb-24 relative overflow-hidden flex items-center">
        <!-- Background Grid / Texture -->
        <div class="absolute inset-0 z-0 opacity-10 pointer-events-none mix-blend-overlay" style="background-image: url('/noise.svg');"></div>
        <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 brightness-100 contrast-150 transform scale-150 pointer-events-none"></div>

        <InteractiveContactForm client:load />
    </main>
</Layout>
