---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "../../lib/sanity";
import {
    GROQ_ALL_POST_SLUGS,
    GROQ_POST_BY_SLUG,
} from "../../lib/sanityQueries";
import { urlFor } from "../../lib/sanity";
import { PortableText } from "astro-portabletext";
import Image from "../../components/portableText/Image.astro";
import Callout from "../../components/portableText/Callout.astro";
import Table from "../../components/portableText/Table.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

export async function getStaticPaths() {
    const slugs = await sanityClient.fetch(GROQ_ALL_POST_SLUGS);
    return slugs.map((slug: any) => ({
        params: { slug },
    }));
}

const { slug } = Astro.params;
let post;

try {
    post = await sanityClient.fetch(GROQ_POST_BY_SLUG, { slug });
} catch (e) {
    console.error("Error fetching post data:", e);
}

if (!post) {
    return Astro.redirect("/404");
}

// SEO Defaults & Overrides
const title = post.seoGroup?.seoTitle || `${post.title} | Adbites Magazin`;
const description =
    post.seoGroup?.metaDescription ||
    post.excerpt ||
    "Read the latest insights from Adbites on e-commerce, digital strategy, and performance marketing.";
const canonicalURL =
    post.seoGroup?.canonicalUrl ||
    new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

const pubDateStr = new Date(post.publishedAt).toISOString();
const organizationName = "Adbites";
const authorName = post.author?.name || organizationName;

// Breadcrumbs Data
const breadcrumbItems = [
    { label: "Home", href: "/" },
    { label: "Magazin", href: "/magazin" },
    { label: post.title },
];

// JSON-LD Schemas
const schemas: any[] = [
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
            "@type": "WebPage",
            "@id": canonicalURL,
        },
        headline: post.title,
        description: description,
        image: post.mainImage
            ? urlFor(post.mainImage)
                  .width(1200)
                  .height(630)
                  .auto("format")
                  .url()
            : "https://adbites.com/default-share-image.jpg",
        author: {
            "@type": "Person",
            name: authorName,
            url: post.author?.sameAs?.[0] || "https://adbites.com",
        },
        publisher: {
            "@type": "Organization",
            name: organizationName,
            logo: {
                "@type": "ImageObject",
                url: "https://adbites.com/logo.png", // Update with real logo URL later
            },
        },
        datePublished: pubDateStr,
        dateModified: pubDateStr, // Update if you add _updatedAt to Sanity
    },
];

if (post.faqs && post.faqs.length > 0) {
    schemas.push({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: post.faqs.map((faq: any) => ({
            "@type": "Question",
            name: faq.question,
            acceptedAnswer: {
                "@type": "Answer",
                text: faq.answer,
            },
        })),
    });
}

const schemaJson = JSON.stringify(schemas);
---

<Layout title={title}>
    <meta slot="head" name="description" content={description} />
    <link slot="head" rel="canonical" href={canonicalURL} />

    <!-- Open Graph Data -->
    <meta slot="head" property="og:title" content={title} />
    <meta slot="head" property="og:type" content="article" />
    <meta slot="head" property="og:url" content={canonicalURL} />
    {
        post.mainImage && (
            <meta
                slot="head"
                property="og:image"
                content={urlFor(post.mainImage)
                    .width(1200)
                    .height(630)
                    .auto("format")
                    .url()}
            />
        )
    }
    <meta slot="head" property="og:description" content={description} />

    <!-- Twitter Card -->
    <meta slot="head" name="twitter:card" content="summary_large_image" />
    <meta slot="head" name="twitter:title" content={title} />
    <meta slot="head" name="twitter:description" content={description} />
    {
        post.mainImage && (
            <meta
                slot="head"
                name="twitter:image"
                content={urlFor(post.mainImage)
                    .width(1200)
                    .height(630)
                    .auto("format")
                    .url()}
            />
        )
    }

    <!-- JSON-LD Structured Data -->
    <script slot="head" type="application/ld+json" set:html={schemaJson} />

    <main class="pt-32 pb-24 bg-[#18181B] min-h-screen text-zinc-100">
        <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <Breadcrumbs items={breadcrumbItems} />
            {/* Categories */}
            {
                post.categories && post.categories.length > 0 && (
                    <div class="flex gap-2 mb-6">
                        {post.categories.map((cat: string) => (
                            <span class="px-3 py-1 bg-brand-primary/10 text-brand-primary text-xs font-semibold tracking-wider uppercase rounded-full border border-brand-primary/20">
                                {cat}
                            </span>
                        ))}
                    </div>
                )
            }

            {/* Header */}
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-8 leading-[1.1]"
            >
                {post.title}
            </h1>

            {/* Meta info block */}
            <div
                class="flex items-center gap-6 mb-12 py-6 border-y border-zinc-800/50"
            >
                {
                    post.author && (
                        <div class="flex items-center gap-4">
                            {post.author.image && (
                                <img
                                    src={urlFor(post.author.image)
                                        .width(100)
                                        .height(100)
                                        .auto("format")
                                        .url()}
                                    alt={post.author.name}
                                    class="w-12 h-12 rounded-full border border-zinc-700"
                                />
                            )}
                            <div>
                                <p class="font-medium text-white">
                                    {post.author.name}
                                </p>
                            </div>
                        </div>
                    )
                }
                <div class="h-8 w-px bg-zinc-800"></div>
                <div class="flex flex-col">
                    <span class="text-sm text-zinc-500">Veröffentlicht am</span>
                    <time
                        datetime={post.publishedAt}
                        class="font-medium text-zinc-300"
                    >
                        {
                            new Date(post.publishedAt).toLocaleDateString(
                                "de-DE",
                                {
                                    month: "long",
                                    day: "numeric",
                                    year: "numeric",
                                },
                            )
                        }
                    </time>
                </div>
            </div>

            {/* Hero Image */}
            {
                post.mainImage && (
                    <div class="w-full h-auto mb-16 rounded-2xl overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.5)] border border-zinc-800/50">
                        <img
                            src={urlFor(post.mainImage)
                                .width(1200)
                                .height(675)
                                .auto("format")
                                .url()}
                            alt={post.title}
                            loading="eager"
                            class="w-full h-full object-cover"
                        />
                    </div>
                )
            }

            {/* Portable Text Content */}
            <div
                class="prose prose-invert prose-lg max-w-none prose-p:text-[#D4D4D8] prose-li:text-[#D4D4D8]
                  prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-white
                  prose-h2:mt-12
                  prose-a:text-brand-primary prose-a:no-underline hover:prose-a:underline
                  prose-img:rounded-xl prose-img:border prose-img:border-zinc-800
                  prose-blockquote:border-l-brand-primary prose-blockquote:bg-zinc-900/50 prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:not-italic
                  [&>p:first-of-type]:text-xl [&>p:first-of-type]:text-zinc-200 [&>p:first-of-type]:leading-relaxed"
            >
                {
                    post.body ? (
                        <PortableText
                            value={post.body}
                            components={{
                                type: {
                                    image: Image,
                                    callout: Callout,
                                    table: Table,
                                },
                            }}
                        />
                    ) : (
                        <p>Content coming soon.</p>
                    )
                }
            </div>

            {/* FAQ Section */}
            {
                post.faqs && post.faqs.length > 0 && (
                    <div class="mt-16 pt-10 border-t border-zinc-800/50">
                        <h2 class="text-3xl font-bold text-white font-heading mb-8">
                            Frequently Asked Questions
                        </h2>
                        <div class="space-y-6">
                            {post.faqs.map((faq: any) => (
                                <details class="group bg-zinc-900/30 border border-zinc-800/50 rounded-2xl overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                                    <summary class="flex items-center justify-between gap-4 p-6 cursor-pointer font-bold text-lg text-white font-heading">
                                        {faq.question}
                                        <span class="transition group-open:rotate-180 text-brand-primary">
                                            <svg
                                                fill="none"
                                                height="24"
                                                stroke="currentColor"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="1.5"
                                                viewBox="0 0 24 24"
                                                width="24"
                                            >
                                                <path d="M6 9l6 6 6-6" />
                                            </svg>
                                        </span>
                                    </summary>
                                    <div class="p-6 pt-0 text-zinc-400 prose prose-sm prose-invert max-w-none">
                                        <p>{faq.answer}</p>
                                    </div>
                                </details>
                            ))}
                        </div>
                    </div>
                )
            }

            {/* Sources Section */}
            {
                post.sources && post.sources.length > 0 && (
                    <div class="mt-12 pt-8 border-t border-zinc-900/50">
                        <h3 class="text-xs font-semibold uppercase tracking-widest text-zinc-500 mb-4">
                            Sources & References
                        </h3>
                        <ol class="list-decimal list-inside space-y-2">
                            {post.sources.map((source: any) => (
                                <li class="text-sm text-zinc-400">
                                    <cite class="not-italic">
                                        <a
                                            href={source.url}
                                            target="_blank"
                                            rel="noopener noreferrer nofollow"
                                            class="hover:text-brand-primary transition-colors hover:underline underline-offset-4 decoration-brand-primary/50"
                                        >
                                            {source.title}
                                        </a>
                                    </cite>
                                    <span class="sr-only"> (External URL)</span>
                                </li>
                            ))}
                        </ol>
                    </div>
                )
            }

            {/* Author Box */}
            {
                post.author && (
                    <aside class="mt-20 pt-10 border-t border-zinc-800/50">
                        <div class="flex flex-col sm:flex-row gap-8 items-start bg-zinc-900/30 rounded-[2rem] p-8 sm:p-10 border border-zinc-800/50 shadow-2xl relative overflow-hidden group hover:border-brand-primary/30 transition-colors duration-500">
                            <div class="absolute inset-0 bg-gradient-to-br from-brand-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-2xl" />

                            {post.author.image && (
                                <div class="flex-shrink-0 relative z-10">
                                    <div class="w-24 h-24 sm:w-32 sm:h-32 rounded-2xl overflow-hidden border border-zinc-700/50 ring-4 ring-black/40 shadow-xl">
                                        <img
                                            src={urlFor(post.author.image)
                                                .width(256)
                                                .height(256)
                                                .auto("format")
                                                .url()}
                                            alt={post.author.name}
                                            class="w-full h-full object-cover"
                                        />
                                    </div>
                                </div>
                            )}

                            <div class="flex-1 relative z-10">
                                <div class="flex flex-col mb-4">
                                    <span class="text-xs font-semibold uppercase tracking-widest text-brand-primary mb-2">
                                        Geschrieben von
                                    </span>
                                    <h3 class="text-3xl font-bold text-white font-heading">
                                        {post.author.name}
                                    </h3>
                                    {post.author.role && (
                                        <p class="text-brand-primary font-medium text-sm mt-1">
                                            {post.author.role}
                                        </p>
                                    )}
                                </div>

                                {post.author.bio && (
                                    <div class="prose prose-sm prose-invert text-zinc-400 max-w-none prose-p:leading-relaxed prose-a:text-brand-primary hover:prose-a:text-white transition-colors">
                                        <PortableText value={post.author.bio} />
                                    </div>
                                )}

                                {post.author.sameAs &&
                                    post.author.sameAs.length > 0 && (
                                        <div class="mt-8 flex flex-wrap gap-4">
                                            {post.author.sameAs.map(
                                                (url: string) => (
                                                    <a
                                                        href={url}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-800/50 border border-zinc-700 hover:bg-zinc-800 hover:border-zinc-600 transition-all text-sm font-medium text-zinc-300 hover:text-white"
                                                    >
                                                        {url.includes(
                                                            "linkedin.com",
                                                        )
                                                            ? "LinkedIn"
                                                            : url.includes(
                                                                    "twitter.com",
                                                                ) ||
                                                                url.includes(
                                                                    "x.com",
                                                                )
                                                              ? "X (Twitter)"
                                                              : "Connect"}
                                                        <svg
                                                            class="w-4 h-4"
                                                            fill="none"
                                                            viewBox="0 0 24 24"
                                                            stroke="currentColor"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                            />
                                                        </svg>
                                                    </a>
                                                ),
                                            )}
                                        </div>
                                    )}
                            </div>
                        </div>
                    </aside>
                )
            }
        </article>
    </main>
</Layout>
