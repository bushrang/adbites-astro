---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "../../lib/sanity";
import { GROQ_ALL_POSTS } from "../../lib/sanityQueries";
import { urlFor } from "../../lib/sanity";
import Breadcrumbs from "../../components/Breadcrumbs.astro";

let posts: any[] = [];
try {
    posts = await sanityClient.fetch(GROQ_ALL_POSTS);
} catch (e) {
    console.error("Error fetching blog posts:", e);
}

const title = "Magazin | Adbites - In-Depth E-Commerce Strategy";
const description =
    "Read our latest articles on Meta Ads, growth strategies, and scaling D2C e-commerce brands.";

const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description: description,
    url: Astro.url.href,
    mainEntity: {
        "@type": "ItemList",
        itemListElement: posts.map((post: any, index: number) => ({
            "@type": "ListItem",
            position: index + 1,
            url: new URL(
                `/magazin/${post.slug}`,
                Astro.site || Astro.url.origin,
            ).href,
            name: post.title,
        })),
    },
});

const breadcrumbItems = [{ label: "Home", href: "/" }, { label: "Magazin" }];
---

<Layout title={title}>
    <meta slot="head" name="description" content={description} />
    <script slot="head" type="application/ld+json" set:html={schema} />

    <main class="pt-32 pb-24 bg-zinc-950 min-h-screen text-zinc-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <Breadcrumbs items={breadcrumbItems} />
            <div class="text-center max-w-3xl mx-auto mb-20 mt-8">
                <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-6">
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-500"
                    >
                        Insights
                    </span>
                    <br /> & Strategies
                </h1>
                <p class="text-xl text-zinc-400">
                    Deep dives into e-commerce growth, paid performance, and
                    advanced tracking infrastructure.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    posts.length > 0 ? (
                        posts.map((post: any) => (
                            <a
                                href={`/magazin/${post.slug}`}
                                class="group block h-full"
                            >
                                <article class="bg-zinc-900/50 border border-zinc-800/50 rounded-2xl overflow-hidden hover:border-emerald-500/30 transition-all duration-300 h-full flex flex-col hover:shadow-[0_0_30px_rgba(16,185,129,0.1)]">
                                    <div class="relative h-48 sm:h-64 w-full overflow-hidden bg-zinc-800">
                                        {post.mainImage ? (
                                            <img
                                                src={urlFor(post.mainImage)
                                                    .width(800)
                                                    .height(450)
                                                    .auto("format")
                                                    .url()}
                                                alt={post.title}
                                                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <div class="w-full h-full flex items-center justify-center text-zinc-600">
                                                No Image available
                                            </div>
                                        )}
                                        {post.categories &&
                                            post.categories.length > 0 && (
                                                <div class="absolute top-4 left-4 flex gap-2">
                                                    <span class="px-3 py-1 bg-black/60 backdrop-blur-md rounded-full text-xs font-medium text-emerald-400 border border-emerald-500/20">
                                                        {post.categories[0]}
                                                    </span>
                                                </div>
                                            )}
                                    </div>

                                    <div class="p-6 flex-1 flex flex-col">
                                        <div class="flex items-center gap-4 text-xs text-zinc-400 mb-4">
                                            <time datetime={post.publishedAt}>
                                                {new Date(
                                                    post.publishedAt,
                                                ).toLocaleDateString("de-DE", {
                                                    month: "long",
                                                    day: "numeric",
                                                    year: "numeric",
                                                })}
                                            </time>
                                        </div>

                                        <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-emerald-400 transition-colors">
                                            {post.title}
                                        </h2>

                                        {post.excerpt && (
                                            <p class="text-zinc-400 line-clamp-3 mb-6 flex-1">
                                                {post.excerpt}
                                            </p>
                                        )}

                                        {post.author && (
                                            <div class="flex items-center gap-3 mt-auto pt-4 border-t border-zinc-800/50">
                                                {post.author.image && (
                                                    <img
                                                        src={urlFor(
                                                            post.author.image,
                                                        )
                                                            .width(100)
                                                            .height(100)
                                                            .auto("format")
                                                            .url()}
                                                        alt={post.author.name}
                                                        class="w-8 h-8 rounded-full border border-zinc-800"
                                                    />
                                                )}
                                                <span class="text-sm font-medium text-zinc-300">
                                                    {post.author.name}
                                                </span>
                                            </div>
                                        )}
                                    </div>
                                </article>
                            </a>
                        ))
                    ) : (
                        <div class="col-span-full text-center py-20 bg-zinc-900/50 border border-zinc-800/50 rounded-2xl">
                            <p class="text-zinc-400 text-lg">
                                No articles found. Check back soon for fresh
                                insights!
                            </p>
                        </div>
                    )
                }
            </div>
        </div>
    </main>
</Layout>
