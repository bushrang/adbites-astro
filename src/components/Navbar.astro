---

---

<nav
    class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-6 px-6 md:px-12"
>
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
            <img
                src="/assets/images/adbites_logo_white.png"
                alt="Adbites Logo"
                class="h-8 w-auto transition-transform duration-300 group-hover:scale-105"
            />
        </a>

        <!-- Desktop Menu -->
        <div
            class="hidden md:flex items-center gap-8 bg-white/5 backdrop-blur-md px-8 py-3 rounded-full border border-white/5"
        >
            <div class="relative group">
                <a
                    href="#services"
                    class="text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-1 py-2"
                >
                    Produkte
                    <svg
                        class="w-3 h-3 text-slate-500 transition-transform group-hover:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"></path>
                    </svg>
                </a>
                <div
                    class="absolute left-1/2 -translate-x-1/2 top-full pt-2 w-56 hidden group-hover:block"
                >
                    <div
                        class="bg-[#0a0f1c]/90 backdrop-blur-xl border border-white/10 rounded-xl overflow-hidden shadow-2xl p-2 flex flex-col gap-1"
                    >
                        <a
                            href="/produkte/avatar/"
                            class="block px-4 py-3 rounded-lg text-sm text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            <span class="block font-bold text-white mb-0.5"
                                >Avatar+</span
                            >
                            <span class="block text-xs text-gray-500"
                                >Retail Growth & Store Visits</span
                            >
                        </a>
                        <a
                            href="/produkte/adlift"
                            class="block px-4 py-3 rounded-lg text-sm text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            <span class="block font-bold text-white mb-0.5"
                                >AdLift</span
                            >
                            <span class="block text-xs text-gray-500"
                                >Wenn Werbeanzeigen extrem smart werden</span
                            >
                        </a>

                        <a
                            href="#"
                            class="block px-4 py-3 rounded-lg text-sm text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            <span class="block font-bold text-white mb-0.5"
                                >StorePilot</span
                            >
                            <span class="block text-xs text-gray-500"
                                >Der einzige Chatbot, der dir direkt Kunden
                                bringt</span
                            >
                        </a>
                        <a
                            href="/produkte/listings/"
                            class="block px-4 py-3 rounded-lg text-sm text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            <span class="block font-bold text-white mb-0.5"
                                >Listings</span
                            >
                            <span class="block text-xs text-gray-500"
                                >Mehr Sichtbarkeit bei Google und KI</span
                            >
                        </a>
                        <a
                            href="/produkte/listings/"
                            class="block px-4 py-3 rounded-lg text-sm text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            <span class="block font-bold text-white mb-0.5"
                                >Automation</span
                            >
                            <span class="block text-xs text-gray-500"
                                >Retail Growth & Store Visits</span
                            >
                        </a>
                        <a
                            href="/produkte/closer/"
                            class="block px-4 py-3 rounded-lg text-sm text-gray-200 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            <span class="block font-bold text-white mb-0.5"
                                >Closer</span
                            >
                            <span class="block text-xs text-gray-500"
                                >Dein Autopilot gegen Beratungsklau</span
                            >
                        </a>

                        <a
                            href="#services"
                            class="block px-4 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/10 transition-colors"
                        >
                            Alle Produkte ansehen →
                        </a>
                    </div>
                </div>
            </div>
            <a
                href="#branchen"
                class="text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-1"
            >
                Branchen <svg
                    class="w-3 h-3 text-slate-500"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path></svg
                >
            </a>

            <a
                href="#pricing"
                class="text-sm font-medium text-slate-300 hover:text-white transition-colors"
                >Preise</a
            >
            <a
                href="/magazin"
                class="text-sm font-medium text-slate-300 hover:text-white transition-colors"
                >Magazin</a
            >
            <a
                href="#about"
                class="text-sm font-medium text-slate-300 hover:text-white transition-colors"
                >Über Uns</a
            >
        </div>

        <!-- CTA -->
        <a
            href="/kontakt"
            class="hidden md:block px-6 py-3 bg-brand-primary text-white font-heading font-medium rounded-lg hover:bg-[#e04f00] transition-colors shadow-lg shadow-brand-primary/20 text-sm"
        >
            Kontakt aufnehmen
        </a>

        <!-- Mobile Menu Button -->
        <button class="md:hidden text-white p-2">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                class="w-6 h-6"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
        </button>
    </div>
</nav>
