---
import { sanityClient } from "../lib/sanity";
import { GROQ_NAVIGATION } from "../lib/sanityQueries";

let nav: any = null;
try {
    nav = await sanityClient.fetch(GROQ_NAVIGATION);
} catch (e) {
    console.error("Navigation fetch error:", e);
}

// ── Icon SVG map ──
const iconPaths: Record<string, string> = {
    arrow: '<path d="M13 7l5 5m0 0l-5 5m5-5H6"/>',
    search: '<path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>',
    video: '<path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>',
    chat: '<path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>',
    image: '<path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
    settings: '<path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>',
    zap: '<path d="M13 2L3 14h9l-1 10 10-12h-9l1-10z"/>',
    globe: '<path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>',
    shield: '<path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
    star: '<path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>',
};

// ── Color map ──
const colorMap: Record<string, { bg: string; border: string; text: string }> = {
    brand: { bg: 'bg-brand-primary/10', border: 'border-brand-primary/20', text: 'text-brand-primary' },
    emerald: { bg: 'bg-emerald-500/10', border: 'border-emerald-500/20', text: 'text-emerald-400' },
    violet: { bg: 'bg-violet-500/10', border: 'border-violet-500/20', text: 'text-violet-400' },
    sky: { bg: 'bg-sky-500/10', border: 'border-sky-500/20', text: 'text-sky-400' },
    pink: { bg: 'bg-pink-500/10', border: 'border-pink-500/20', text: 'text-pink-400' },
    amber: { bg: 'bg-amber-500/10', border: 'border-amber-500/20', text: 'text-amber-400' },
};

// ── Fallback data ──
const defaultColumns = [
    {
        columnTitle: 'Reichweite & Sichtbarkeit',
        items: [
            { label: 'AdLift', description: 'Smarte Werbeanzeigen, die Kunden in deinen Laden bringen', href: '/produkte/adlift', iconColor: 'brand', iconName: 'arrow' },
            { label: 'Listings', description: 'Sichtbarkeit bei Google, ChatGPT & allen KI-Suchmaschinen', href: '/produkte/listings', iconColor: 'emerald', iconName: 'search' },
            { label: 'Avatar+', description: 'Dein digitaler Zwilling verkauft 24/7 per Video', href: '/produkte/avatar', iconColor: 'violet', iconName: 'video' },
        ],
    },
    {
        columnTitle: 'Engagement & Konversion',
        items: [
            { label: 'ShopPilot', description: 'Der Chatbot, der dir direkt Kunden bringt', href: '/produkte/shoppilot-chatbot', iconColor: 'sky', iconName: 'chat' },
            { label: 'Social Media Content', description: 'Professioneller Content zum Fixpreis', href: '/produkte/social-media-content', iconColor: 'pink', iconName: 'image' },
        ],
    },
];

const defaultTopLinks = [
    { label: 'Branchen', href: '/branchen' },
    { label: 'Preise', href: '#pricing' },
    { label: 'Tools', href: '/tools' },
    { label: 'Magazin', href: '/magazin' },
    { label: 'Über Uns', href: '/ueber-uns' },
];

const columns = nav?.megaMenuColumns?.length ? nav.megaMenuColumns : defaultColumns;
const topLinks = nav?.topLinks?.length ? nav.topLinks : defaultTopLinks;
const ctaText = nav?.ctaText || 'Kontakt aufnehmen';
const ctaUrl = nav?.ctaUrl || '/kontakt';
const featuredLabel = nav?.featuredLabel || 'Highlight';
const featuredTitle = nav?.featuredTitle || 'Dein Rundum-Sorglos-Paket für den stationären Handel';
const featuredText = nav?.featuredText || 'Werbung, Content, Chatbot, Listings – alles aus einer Hand. Speziell für Einzelhändler, die online sichtbar werden wollen.';
const featuredBtnText = nav?.featuredButtonText || 'Jetzt beraten lassen';
const featuredBtnUrl = nav?.featuredButtonUrl || '/kontakt';
const featuredImageUrl = nav?.featuredImageUrl || null;

// Flatten all items for mobile
const allItems = columns.flatMap((col: any) => col.items || []);
---

<nav class="fixed top-0 left-0 w-full z-50 transition-all duration-300 py-6 px-6 md:px-12" id="main-nav">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group relative z-[60]">
            <img src="/assets/images/adbites_logo_white.png" alt="Adbites Logo" class="h-8 w-auto transition-transform duration-300 group-hover:scale-105" />
        </a>

        <!-- Desktop Menu -->
        <div class="hidden lg:flex items-center gap-8 bg-white/5 backdrop-blur-md px-8 py-3 rounded-full border border-white/5">
            <!-- Produkte Trigger -->
            <button type="button" id="mega-trigger" class="text-sm font-medium text-slate-300 hover:text-white transition-colors flex items-center gap-1 py-2 bg-transparent border-none cursor-pointer">
                Produkte
                <svg class="w-3 h-3 text-slate-500 transition-transform duration-300" id="mega-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>

            {topLinks.map((link: any) => (
                <a href={link.href} class="text-sm font-medium text-slate-300 hover:text-white transition-colors">{link.label}</a>
            ))}
        </div>

        <!-- CTA -->
        <a href={ctaUrl} class="hidden lg:block px-6 py-3 bg-brand-primary text-white font-heading font-medium rounded-lg hover:bg-[#e04f00] transition-colors shadow-lg shadow-brand-primary/20 text-sm relative z-[60]">
            {ctaText}
        </a>

        <!-- Mobile Menu Button -->
        <button class="lg:hidden text-white p-2 relative z-[60]" id="mobile-toggle" aria-label="Menu">
            <svg id="mobile-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
            </svg>
            <svg id="mobile-icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6 hidden">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- ═══════════════ DESKTOP MEGA MENU ═══════════════ -->
    <div id="mega-panel" class="hidden lg:block fixed inset-x-0 top-0 z-40 pointer-events-none opacity-0 translate-y-[-10px] transition-all duration-300">
        <div class="pt-[88px]">
            <div class="max-w-6xl mx-auto px-6">
                <div class="pointer-events-auto bg-[#0c1020]/95 backdrop-blur-2xl border border-white/10 rounded-2xl shadow-[0_25px_60px_rgba(0,0,0,0.6)] p-8" style={`display:grid; grid-template-columns: ${'1fr '.repeat(columns.length)}1.1fr; gap: 2rem;`}>
                    {columns.map((col: any) => (
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-slate-500 mb-5">{col.columnTitle}</p>
                            <div class="flex flex-col gap-1">
                                {(col.items || []).map((item: any) => {
                                    const c = colorMap[item.iconColor] || colorMap.brand;
                                    const svgPath = iconPaths[item.iconName] || iconPaths.arrow;
                                    return (
                                        <a href={item.href} class="mega-link group flex items-start gap-3.5 px-3 py-3 rounded-xl hover:bg-white/5 transition-colors">
                                            <span class={`mt-0.5 flex items-center justify-center w-9 h-9 rounded-lg ${c.bg} border ${c.border} ${c.text} shrink-0`}>
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={svgPath} />
                                            </span>
                                            <div>
                                                <span class="block text-[13px] font-semibold text-white group-hover:text-brand-primary transition-colors">{item.label}</span>
                                                <span class="block text-[11px] text-slate-500 leading-snug mt-0.5">{item.description}</span>
                                            </div>
                                        </a>
                                    );
                                })}
                            </div>
                        </div>
                    ))}

                    <!-- Featured Box -->
                    <div class="bg-gradient-to-br from-brand-primary/10 via-brand-primary/5 to-transparent rounded-xl border border-white/5 p-6 flex flex-col justify-between overflow-hidden">
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-brand-primary mb-3">{featuredLabel}</p>
                            <h3 class="text-lg font-heading font-bold text-white leading-snug mb-2">{featuredTitle}</h3>
                            <p class="text-[12px] text-slate-400 leading-relaxed">{featuredText}</p>
                        </div>
                        {featuredImageUrl && (
                            <img src={featuredImageUrl} alt={featuredTitle} class="mt-4 w-full h-auto rounded-lg object-cover max-h-[160px]" loading="eager" />
                        )}
                        <a href={featuredBtnUrl} class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 bg-brand-primary text-white text-xs font-bold rounded-lg hover:bg-[#e04f00] transition-colors shadow-lg shadow-brand-primary/20 self-start">
                            {featuredBtnText}
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Click-away overlay -->
    <div id="mega-overlay" class="hidden fixed inset-0 z-30"></div>

    <!-- ═══════════════ MOBILE MENU ═══════════════ -->
    <div id="mobile-menu" class="lg:hidden fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
        <div class="absolute inset-0 bg-[#070b16]/98 backdrop-blur-xl"></div>
        <div class="relative z-10 flex flex-col h-full pt-24 px-6 pb-8 overflow-y-auto">
            <!-- Produkte Accordion -->
            <div class="border-b border-white/10">
                <button id="mob-produkte-btn" class="w-full flex items-center justify-between py-4 text-left bg-transparent border-none cursor-pointer">
                    <span class="text-lg font-heading font-bold text-white">Produkte</span>
                    <svg id="mob-produkte-chevron" class="w-4 h-4 text-slate-500 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <div id="mob-produkte-panel" class="hidden pb-4 pl-2 flex flex-col gap-1">
                    {allItems.map((item: any) => {
                        const c = colorMap[item.iconColor] || colorMap.brand;
                        const svgPath = iconPaths[item.iconName] || iconPaths.arrow;
                        return (
                            <a href={item.href} class="flex items-center gap-3 px-3 py-3 rounded-xl hover:bg-white/5 transition-colors">
                                <span class={`flex items-center justify-center w-8 h-8 rounded-lg ${c.bg} ${c.text} shrink-0`}>
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={svgPath} />
                                </span>
                                <div>
                                    <span class="block text-sm font-semibold text-white">{item.label}</span>
                                    <span class="block text-[11px] text-slate-500">{item.description}</span>
                                </div>
                            </a>
                        );
                    })}
                </div>
            </div>

            <!-- Top Links -->
            {topLinks.map((link: any) => (
                <a href={link.href} class="block py-4 text-lg font-heading font-bold text-white border-b border-white/10 hover:text-brand-primary transition-colors">{link.label}</a>
            ))}

            <!-- Mobile CTA -->
            <a href={ctaUrl} class="mt-8 block text-center px-6 py-4 bg-brand-primary text-white font-heading font-bold rounded-xl hover:bg-[#e04f00] transition-colors shadow-lg shadow-brand-primary/30 text-base">
                {ctaText}
            </a>
        </div>
    </div>
</nav>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // ── Desktop Mega Menu ──
    const trigger = document.getElementById('mega-trigger');
    const panel = document.getElementById('mega-panel');
    const chevron = document.getElementById('mega-chevron');
    const overlay = document.getElementById('mega-overlay');
    let megaOpen = false;
    let closeTimeout;

    function openMega() {
        clearTimeout(closeTimeout);
        if (megaOpen) return;
        megaOpen = true;
        panel.classList.remove('opacity-0', 'translate-y-[-10px]', 'pointer-events-none');
        panel.classList.add('opacity-100', 'translate-y-0');
        chevron.style.transform = 'rotate(180deg)';
        overlay.classList.remove('hidden');
    }

    function closeMega() {
        closeTimeout = setTimeout(() => {
            megaOpen = false;
            panel.classList.add('opacity-0', 'translate-y-[-10px]', 'pointer-events-none');
            panel.classList.remove('opacity-100', 'translate-y-0');
            chevron.style.transform = '';
            overlay.classList.add('hidden');
        }, 100);
    }

    if (trigger && panel) {
        trigger.addEventListener('mouseenter', openMega);
        trigger.addEventListener('click', () => megaOpen ? closeMega() : openMega());
        panel.addEventListener('mouseenter', () => clearTimeout(closeTimeout));
        panel.addEventListener('mouseleave', closeMega);
        trigger.addEventListener('mouseleave', closeMega);
        overlay.addEventListener('click', closeMega);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMega(); });
    }

    // ── Mobile Menu ──
    const mobToggle = document.getElementById('mobile-toggle');
    const mobMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('mobile-icon-open');
    const iconClose = document.getElementById('mobile-icon-close');
    let mobOpen = false;

    function toggleMobile() {
        mobOpen = !mobOpen;
        if (mobOpen) {
            mobMenu.classList.remove('pointer-events-none', 'opacity-0');
            mobMenu.classList.add('pointer-events-auto', 'opacity-100');
            iconOpen.classList.add('hidden');
            iconClose.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        } else {
            mobMenu.classList.add('pointer-events-none', 'opacity-0');
            mobMenu.classList.remove('pointer-events-auto', 'opacity-100');
            iconOpen.classList.remove('hidden');
            iconClose.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    if (mobToggle) mobToggle.addEventListener('click', toggleMobile);
    mobMenu?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => { if (mobOpen) toggleMobile(); });
    });

    // ── Mobile Accordion ──
    const prodBtn = document.getElementById('mob-produkte-btn');
    const prodPanel = document.getElementById('mob-produkte-panel');
    const prodChevron = document.getElementById('mob-produkte-chevron');

    if (prodBtn && prodPanel) {
        prodBtn.addEventListener('click', () => {
            const isOpen = !prodPanel.classList.contains('hidden');
            prodPanel.classList.toggle('hidden');
            prodChevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        });
    }
});
</script>
