---
interface Props {
    data?: {
        headline?: string;
        subline?: string;
        videoUrl?: string;
    };
}

const { data } = Astro.props;

// Fallbacks
const headline =
    data?.headline ||
    'Adbites in 30 Sekunden: <br class="hidden md:block" /> <span class="text-white"> So arbeitet das Adbites LTS System für dich. </span>';
const subline =
    data?.subline ||
    "Alles zu kompliziert? Heiko erklärt dir in 30 Sekunden, wie Adbites funktioniert.";
// Default Video URL (extracting the ID)
const videoUrl = data?.videoUrl || "https://youtu.be/vIFlpFmH6gw";

// Extract YouTube ID for embed
function getYoutubeId(url: string) {
    const regExp =
        /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
    const match = url.match(regExp);
    return match && match[2].length === 11 ? match[2] : null;
}
const youtubeId = getYoutubeId(videoUrl);
const embedUrl = youtubeId
    ? `https://www.youtube.com/embed/${youtubeId}?autoplay=1&rel=0&modestbranding=1&controls=0&showinfo=0&iv_load_policy=3&origin=${Astro.url.origin}`
    : "";
---

<section class="py-24 bg-transparent relative overflow-visible z-10">
    <!-- Subtle Background Glow (Left - Existing) -->
    <div
        class="absolute inset-0
bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))]
from-brand-primary/5 via-[#0d0101] to-[#0d0101] pointer-events-none"
    >
    </div>
    <!-- Right Orange Glow (New) -->
    <div
        class="absolute top-1/2 right-[-200px]
-translate-y-1/2 w-[800px] h-[800px] bg-orange-500/15 blur-[120px] rounded-full
pointer-events-none -z-10"
    >
    </div>
    <div
        class="max-w-7xl mx-auto px-4 sm:px-6
lg:px-8 relative z-10 text-center"
    >
        <div class="mb-12 max-w-3xl mx-auto">
            <h2
                class="text-3xl md:text-5xl font-heading font-bold text-white mb-6
leading-[1.1]"
                set:html={headline}
            />
            <p class="text-slate-400 text-lg">
                {subline}
            </p>
        </div>
        <!-- Video Facade Container -->
        <div
            id="founder-demo-facade"
            class="relative
max-w-5xl mx-auto group cursor-pointer"
            data-embed-url={embedUrl}
        >
            <!-- Glow
Effect behind the video -->
            <div
                class="absolute -inset-1 bg-gradient-to-r
from-brand-primary/20 to-purple-500/20 rounded-2xl blur opacity-25
group-hover:opacity-50 transition duration-1000 group-hover:duration-200"
            >
            </div>
            <!-- Main Video Container -->
            <div
                class="relative bg-slate-900 border
border-white/10 rounded-2xl overflow-hidden aspect-video shadow-2xl"
            >
                <!--
Iframe Container (Initially Hidden) -->
                <div
                    id="founder-demo-iframe-container"
                    class="absolute inset-0 w-full h-full z-50 rounded-2xl hidden"
                >
                </div>
                <!-- Placeholder Abstract UI Background
(Simulating Dashboard) - Hidden when playing -->
                <div
                    id="founder-demo-dashboard-bg"
                    class="absolute inset-0 bg-slate-900 transition-opacity duration-300"
                >
                    {data?.posterImageUrl ? (
                        <img 
                            src={data.posterImageUrl} 
                            alt="Video Thumbnail" 
                            class="w-full h-full object-cover opacity-80" 
                        />
                    ) : (
                        <>
                    <!-- Grid -->
                    <div
                        class="absolute inset-0 opacity-10"
                        style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"
                    >
                    </div>
                    <!-- Abstract Dashboard Elements -->
                    <div
                        class="absolute top-8 left-8 right-8 bottom-8 opacity-20 flex gap-4"
                    >
                        <div
                            class="w-1/4 h-full bg-white/5 rounded-lg border border-white/10"
                        >
                        </div>
                        <div class="w-3/4 h-full flex flex-col gap-4">
                            <div
                                class="h-1/3 bg-white/5 rounded-lg border border-white/10 w-full flex items-center justify-center"
                            >
                                <!-- Map placeholder dots -->
                                <div class="flex gap-8">
                                    <div
                                        class="h-2 w-2 rounded-full bg-red-500 animate-pulse"
                                    >
                                    </div>
                                    <div
                                        class="h-2 w-2 rounded-full bg-red-500 animate-pulse delay-75"
                                    >
                                    </div>
                                    <div
                                        class="h-2 w-2 rounded-full bg-red-500 animate-pulse delay-150"
                                    >
                                    </div>
                                </div>
                            </div>
                            <div
                                class="h-2/3 bg-white/5 rounded-lg border border-white/10"
                            >
                            </div>
                        </div>
                    </div>
                        </>
                    )}
                </div>
                <!-- Thumbnail
Overlay / "Founder pointing" placeholder -->
                <!-- Since we don't have a real
image, we use a gradient overlay and strict typography -->
                <div
                    id="founder-demo-thumbnail-overlay"
                    class="absolute
inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent transition-opacity duration-300"
                >
                </div>
                <!-- Play
Button & Overlay Elements -->
                <div
                    id="founder-demo-play-button"
                    class="absolute inset-0 flex flex-col
items-center justify-center z-40 transition-opacity duration-300"
                >
                    <div
                        class="relative group-hover:scale-110
transition-transform duration-300"
                    >
                        <div
                            class="absolute inset-0
bg-brand-primary blur-xl opacity-20 rounded-full animate-pulse"
                        >
                        </div>
                        <div
                            class="relative w-24 h-24 bg-white/10 backdrop-blur-md rounded-full border
border-white/20 flex items-center justify-center pl-1 shadow-lg
group-hover:bg-white/20 transition-colors"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                                class="size-10 text-brand-primary"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M4.5
5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0
3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z"
                                    clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                    <div class="mt-8 flex
items-center gap-3">
                        
                    </div>
                </div>
                <!-- Fake Player Controls (for the
aesthetic) -->
                <div
                    id="founder-demo-fake-controls"
                    class="absolute bottom-0 left-0 right-0 h-12
bg-gradient-to-t from-slate-950/80 to-transparent px-6 flex items-center gap-4
opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-40"
                >
                    <div
                        class="h-1 flex-1 bg-white/20 rounded-full
overflow-hidden"
                    >
                        <div class="h-full w-1/3 bg-brand-primary rounded-full">
                        </div>
                    </div>
                    <div class="text-xs font-mono text-slate-300">01:30</div>
                </div>
            </div>
            <p
                id="founder-demo-disclaimer"
                class="mt-6 text-sm text-slate-500 transition-opacity duration-300"
            >
                <span class="text-brand-primary">●</span> Video wird datenschutzkonform
                geladen (Klick erforderlich).
            </p>
        </div>
    </div>
</section>

<!-- Loom-style fixed bubble (Hidden by default, shown via JS when scrolled past) -->
<div
    id="founder-demo-bubble"
    class="fixed bottom-6 right-6 z-50 flex flex-col items-center gap-3 transform translate-y-32 opacity-0 transition-all duration-500 pointer-events-none"
>
    <!-- Dismiss Button -->
    <button
        id="founder-demo-bubble-dismiss"
        class="absolute -top-3 -right-3 z-20 w-7 h-7 bg-slate-800 border border-white/20 rounded-full flex items-center justify-center text-white shadow-lg pointer-events-auto hover:bg-red-500 hover:border-red-500 transition-colors"
        aria-label="Dismiss Video Bubble"
    >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    <!-- Rectangular Video Container -->
    <div
        id="founder-demo-bubble-video-container"
        class="relative w-32 h-48 md:w-40 md:h-60 rounded-2xl overflow-hidden border-2 border-brand-primary shadow-[0_0_20px_rgba(255,107,0,0.4)] pointer-events-auto bg-slate-900 group cursor-pointer transition-transform hover:scale-105"
    >
        <video 
            src="/klickercomp.mp4" 
            autoplay 
            loop 
            muted 
            playsinline
            class="absolute inset-0 w-full h-full object-cover"
        ></video>
        
        <!-- Hover Overlay -->
        <div class="absolute inset-0 bg-brand-primary/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
            <div class="w-12 h-12 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center border border-white/30 shadow-lg">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-white">
                    <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"></path>
                </svg>
            </div>
        </div>

        <!-- Recording dot -->
        <div class="absolute top-2 right-2 w-3 h-3 bg-red-500 rounded-full animate-ping"></div>
        <div class="absolute top-2 right-2 w-3 h-3 bg-red-500 rounded-full border border-white/20"></div>
    </div>

    <!-- Play Button -->
    <button
        id="founder-demo-bubble-btn"
        class="pointer-events-auto group flex items-center gap-2 px-5 py-2.5 bg-slate-900/90 backdrop-blur-md border border-white/10 rounded-full text-xs font-bold text-white shadow-lg hover:bg-brand-primary hover:border-brand-primary transition-colors"
        aria-label="Play Founder Video"
    >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 text-brand-primary group-hover:text-white transition-colors">
            <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"></path>
        </svg>
        Video ansehen
    </button>
</div>

<!-- Modal Overlay -->
<div
    id="founder-demo-modal"
    class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-md flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 px-4"
>
    <div class="relative w-full max-w-5xl aspect-video bg-black rounded-2xl border border-white/20 shadow-2xl overflow-hidden transform scale-95 transition-transform duration-300" id="founder-demo-modal-content">
        <button id="founder-demo-modal-close" class="absolute top-4 right-4 z-50 w-10 h-10 bg-black/50 hover:bg-white/10 rounded-full flex items-center justify-center text-white backdrop-blur-md transition-colors" aria-label="Close Video">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <div id="founder-demo-modal-iframe" class="w-full h-full flex items-center justify-center">
            <!-- Iframe injected here -->
        </div>
    </div>
</div>

<script>
    const facade = document.getElementById("founder-demo-facade");
    const iframeContainer = document.getElementById(
        "founder-demo-iframe-container",
    );
    const dashboardBg = document.getElementById("founder-demo-dashboard-bg");
    const thumbnailOverlay = document.getElementById(
        "founder-demo-thumbnail-overlay",
    );
    const playButton = document.getElementById("founder-demo-play-button");
    const fakeControls = document.getElementById("founder-demo-fake-controls");
    const disclaimer = document.getElementById("founder-demo-disclaimer");

    if (facade && iframeContainer) {
        facade.addEventListener("click", () => {
            const embedUrl = facade.getAttribute("data-embed-url");
            if (embedUrl) {
                // Fade out facade elements
                if (dashboardBg) dashboardBg.style.opacity = "0";
                if (thumbnailOverlay) thumbnailOverlay.style.opacity = "0";
                if (playButton) playButton.style.opacity = "0";
                if (fakeControls) fakeControls.style.display = "none";
                if (disclaimer) disclaimer.style.opacity = "0";

                setTimeout(() => {
                    // Hide completely
                    if (dashboardBg) dashboardBg.style.display = "none";
                    if (thumbnailOverlay)
                        thumbnailOverlay.style.display = "none";
                    if (playButton) playButton.style.display = "none";
                    if (disclaimer) disclaimer.style.display = "none";

                    // Show and inject iframe
                    iframeContainer.classList.remove("hidden");
                    iframeContainer.innerHTML = `<iframe class="w-full h-full rounded-2xl" src="${embedUrl}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;

                    // Remove pointer events so iframe can be interacted with directly
                    facade.classList.remove("cursor-pointer");
                    facade.replaceWith(facade.cloneNode(true)); // remove event listeners
                }, 300);
            }
        });
        
        // --- Bubble & Modal Logic ---
        const bubble = document.getElementById("founder-demo-bubble");
        const bubbleDismiss = document.getElementById("founder-demo-bubble-dismiss");
        const bubbleVideoContainer = document.getElementById("founder-demo-bubble-video-container");
        const bubbleBtn = document.getElementById("founder-demo-bubble-btn");
        const modal = document.getElementById("founder-demo-modal");
        const modalContent = document.getElementById("founder-demo-modal-content");
        const modalClose = document.getElementById("founder-demo-modal-close");
        const modalIframeContainer = document.getElementById("founder-demo-modal-iframe");
        const embedUrl = facade.getAttribute("data-embed-url");

        if (bubble && embedUrl) {
            // Check if user previously dismissed the bubble
            const isDismissed = localStorage.getItem("adbites_founder_bubble_dismissed");

            if (isDismissed === "true") {
                // Completely remove the bubble if dismissed
                bubble.remove();
            } else {
                // Observer to show bubble when video is scrolled past
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        // Show bubble if facade is above the viewport
                        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
                            bubble.classList.remove("translate-y-32", "opacity-0");
                        } else {
                            bubble.classList.add("translate-y-32", "opacity-0");
                        }
                    });
                }, { threshold: 0.1 });
                
                observer.observe(facade);

                // Dismiss Logic
                bubbleDismiss?.addEventListener("click", (e) => {
                    e.stopPropagation(); // prevent modal from opening
                    localStorage.setItem("adbites_founder_bubble_dismissed", "true");
                    bubble.classList.add("translate-y-32", "opacity-0");
                    // Wait for transition to finish before removing from DOM
                    setTimeout(() => {
                        bubble.remove();
                    }, 500);
                });

                // Open Modal Logic
            const openModal = () => {
                if (modal && modalIframeContainer) {
                    modal.classList.remove("opacity-0", "pointer-events-none");
                    modalContent?.classList.remove("scale-95");
                    modalContent?.classList.add("scale-100");
                    modalIframeContainer.innerHTML = `<iframe class="w-full h-full" src="${embedUrl}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
                }
            };

            // Bind click events to both the video container and the button
            bubbleVideoContainer?.addEventListener("click", openModal);
            bubbleBtn?.addEventListener("click", openModal);

            // Close Modal
            const closeModal = () => {
                if (modal && modalIframeContainer) {
                    modal.classList.add("opacity-0", "pointer-events-none");
                    modalContent?.classList.remove("scale-100");
                    modalContent?.classList.add("scale-95");
                    // Delay removing iframe so the transition is smooth
                    setTimeout(() => {
                        modalIframeContainer.innerHTML = '';
                    }, 300);
                }
            };

            modalClose?.addEventListener("click", closeModal);
            modal?.addEventListener("click", (e) => {
                if (e.target === modal) closeModal();
            });
        } // End of else block
        } // End of if (bubble && embedUrl)
    } // End of if (facade && iframeContainer)
</script>
