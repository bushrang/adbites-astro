---
const { node } = Astro.props;
const { text, tone = "brand" } = node;

// Compute dynamic classes based on tone
const themeClasses = {
    brand: "from-brand-primary/10 border-brand-primary/30 text-brand-primary",
    info: "from-blue-500/10 border-blue-500/30 text-blue-400",
    success: "from-emerald-500/10 border-emerald-500/30 text-emerald-400",
    warning: "from-amber-500/10 border-amber-500/30 text-amber-400",
};

const activeClass =
    themeClasses[tone as keyof typeof themeClasses] || themeClasses.brand;
---

<div
    class={`my-8 p-6 sm:p-8 rounded-2xl border bg-gradient-to-br to-transparent shadow-lg relative overflow-hidden group transition-all duration-300 ${activeClass}`}
>
    <div class="absolute inset-0 bg-zinc-900/50 -z-10 backdrop-blur-sm"></div>

    {/* Icon based on tone */}
    <div class="mb-4">
        {
            tone === "brand" && (
                <svg
                    class="w-8 h-8 opacity-80"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                </svg>
            )
        }
        {
            tone === "info" && (
                <svg
                    class="w-8 h-8 opacity-80"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                </svg>
            )
        }
        {
            tone === "success" && (
                <svg
                    class="w-8 h-8 opacity-80"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                </svg>
            )
        }
        {
            tone === "warning" && (
                <svg
                    class="w-8 h-8 opacity-80"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    />
                </svg>
            )
        }
    </div>

    <div
        class="prose prose-invert max-w-none prose-p:leading-relaxed prose-p:mt-0 font-medium text-lg text-white"
    >
        <p>{text}</p>
    </div>
</div>
