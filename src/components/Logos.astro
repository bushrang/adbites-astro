---
interface Props {
    data?: {
        name: string;
        imageUrl?: string;
        textMarkup?: string;
        customClass?: string;
    }[];
}

const { data } = Astro.props;

// Fallback to original hardcoded data if no Sanity data is provided
const logos =
    data && data.length > 0
        ? data
        : [
              {
                  name: "happybaby",
                  textMarkup: "happy<span class='font-normal'>♡baby</span>",
              },
              { name: "HolzLand", textMarkup: "HolzLand" },
              {
                  name: "BABYMAXX",
                  textMarkup: "BABY<br />MAXX",
                  customClass: "tracking-widest",
              },
              {
                  name: "MOBEXO",
                  textMarkup: "MOBEXO.",
                  customClass: "tracking-widest",
              },
              {
                  name: "allbaby",
                  textMarkup: "all<span class='text-brand-primary'>baby</span>",
              },
              {
                  name: "ternx",
                  textMarkup: "ternx",
                  customClass: "tracking-widest lowercase",
              },
          ];
---

<section
    class="-mt-12 pb-12 bg-transparent overflow-hidden relative group z-20"
    style="mask-image: linear-gradient(to right, transparent, black 20%, black 80%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 20%, black 80%, transparent);"
>
    <div class="flex w-max animate-scroll group-hover:paused">
        <!-- Original Set -->
        <div
            class="flex shrink-0 gap-16 px-8 items-center opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500"
        >
            {
                logos.map((logo) =>
                    logo.imageUrl ? (
                        <img
                            src={logo.imageUrl}
                            alt={logo.name || "Partner Logo"}
                            class={`shrink-0 h-8 md:h-12 w-auto object-contain ${logo.customClass || ""}`}
                            loading="lazy"
                        />
                    ) : (
                        <span
                            class={`shrink-0 text-xl font-bold font-heading whitespace-nowrap ${logo.customClass || ""}`}
                            set:html={logo.textMarkup}
                        />
                    ),
                )
            }
        </div>
        <!-- Duplicate Set for Infinite Loop -->
        <div
            class="flex shrink-0 gap-16 px-8 items-center opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500"
        >
            {
                logos.map((logo) =>
                    logo.imageUrl ? (
                        <img
                            src={logo.imageUrl}
                            alt={logo.name || "Partner Logo"}
                            class={`shrink-0 h-8 md:h-12 w-auto object-contain ${logo.customClass || ""}`}
                            loading="lazy"
                        />
                    ) : (
                        <span
                            class={`shrink-0 text-xl font-bold font-heading whitespace-nowrap ${logo.customClass || ""}`}
                            set:html={logo.textMarkup}
                        />
                    ),
                )
            }
        </div>
        <!-- Triplicate Set for Infinite Loop safety on wide screens -->
        <div
            class="flex shrink-0 gap-16 px-8 items-center opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500"
        >
            {
                logos.map((logo) =>
                    logo.imageUrl ? (
                        <img
                            src={logo.imageUrl}
                            alt={logo.name || "Partner Logo"}
                            class={`shrink-0 h-8 md:h-12 w-auto object-contain ${logo.customClass || ""}`}
                            loading="lazy"
                        />
                    ) : (
                        <span
                            class={`shrink-0 text-xl font-bold font-heading whitespace-nowrap ${logo.customClass || ""}`}
                            set:html={logo.textMarkup}
                        />
                    ),
                )
            }
        </div>
    </div>
</section>

<style>
    .animate-scroll {
        animation: scroll 60s linear infinite;
    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-33.333333%);
        }
    }
</style>
