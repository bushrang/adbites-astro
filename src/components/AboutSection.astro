---
import { sanityClient } from "sanity:client";
import { GROQ_PERSON } from "../lib/sanityQueries";
import { PortableText } from "astro-portabletext";

const person = await sanityClient.fetch(GROQ_PERSON);
const { name, role, image, bio, knowsAbout } = person || {};
---

<section id="about" class="py-24 bg-brand-dark relative overflow-hidden">
    <!-- Background Texture -->
    <div
        class="absolute inset-0 opacity-5 pointer-events-none"
        style="background-image: url('/noise.svg');"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row items-center gap-16">
            <!-- Image Column -->
            <div class="w-full md:w-1/2 relative group">
                <div
                    class="relative z-10 rounded-2xl overflow-hidden border border-white/10 bg-white/5"
                >
                    {
                        image ? (
                            <img
                                src={image}
                                alt={name}
                                class="w-full h-auto object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
                            />
                        ) : (
                            <div class="aspect-[3/4] bg-slate-800 flex items-center justify-center text-slate-600">
                                No Image Found
                            </div>
                        )
                    }

                    <!-- Overlay Details -->
                    <div
                        class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-brand-dark to-transparent"
                    >
                        <h3 class="text-2xl font-bold text-white">{name}</h3>
                        <p class="text-brand-primary font-medium">{role}</p>
                    </div>
                </div>

                <!-- Decorative Elements -->
                <div
                    class="absolute -top-10 -left-10 w-32 h-32 border-l-2 border-t-2 border-white/10 rounded-tl-3xl"
                >
                </div>
                <div
                    class="absolute -bottom-10 -right-10 w-32 h-32 border-r-2 border-b-2 border-white/10 rounded-br-3xl"
                >
                </div>
                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-brand-primary/20 blur-[100px] pointer-events-none -z-10"
                >
                </div>
            </div>

            <!-- Content Column -->
            <div class="w-full md:w-1/2">
                <div
                    class="inline-block px-3 py-1 bg-white/5 border border-white/10 rounded-full text-brand-primary text-xs font-bold mb-6"
                >
                    WHO WE ARE
                </div>
                <h2
                    class="text-4xl md:text-5xl font-bold text-white mb-8 font-heading leading-tight"
                >
                    Nicht noch eine <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-orange-400"
                        >08/15 Agentur.</span
                    >
                </h2>

                <div
                    class="prose prose-invert prose-lg text-slate-300 mb-10 leading-relaxed"
                >
                    {
                        bio ? (
                            <PortableText value={bio} />
                        ) : (
                            <p>
                                Wir verbinden strategisches Marketing mit
                                modernster Technologie.
                            </p>
                        )
                    }
                </div>

                <!-- Skills / Knows About -->
                {
                    knowsAbout && (
                        <div class="mb-10">
                            <h4 class="text-white font-bold text-sm uppercase tracking-wider mb-4 opacity-70">
                                Core Competencies
                            </h4>
                            <div class="flex flex-wrap gap-2">
                                {knowsAbout.map((skill: string) => (
                                    <span class="px-3 py-1.5 bg-white/5 border border-white/10 rounded text-sm text-white hover:border-brand-primary/50 transition-colors cursor-default">
                                        {skill}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )
                }

                <a
                    href="#contact"
                    class="inline-flex items-center gap-2 text-brand-primary font-bold hover:text-white transition-colors group"
                >
                    Lass uns sprechen
                    <svg
                        class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                    >
                </a>
            </div>
        </div>
    </div>
</section>
