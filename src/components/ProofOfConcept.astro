---
const { data } = Astro.props;

// Use CMS data if available, otherwise fallback to the hardcoded default cases
const headline = data?.headline || 'Funktioniert das wirklich? <br /> <span class="text-white">Hier sind die Daten.</span>';

const cases = data?.cases && data.cases.length > 0 ? data.cases : [
    {
        title: "Der Mode-Händler",
        badge: "Fokus: Frequenz-Steigerung",
        challenge: '"Unsichtbar für Neukunden da Nebenstraße. Wenig Laufkundschaft."',
        solution: "Datengestütztes Targeting auf Neubaugebiet mit hoher Familiendichte + Digitales Rubbellos.",
        metrics: [
            { value: "+142", label: "Eingelöste Gutscheine<br />(in 4 Wochen)" },
            { value: "+24%", label: "Umsatz an Samstagen" }
        ],
        linkText: "Ganze Fallstudie lesen"
    },
    {
        title: "Der Feinkost-Laden",
        badge: "Fokus: Warenkorb-Wert",
        challenge: '"Kunden kauften nur billige Kleinigkeiten. Kein Premium-Umsatz."',
        solution: "Targeting auf einkommensstarke Viertel (ARIA) + Verhaltensdaten aus vergleichbaren Genuss-Kampagnen.",
        metrics: [
            { value: "48€", label: "Ø Warenkorb<br />(vorher 22€)" },
            { value: "56", label: "Neue Stammkunden<br />Anmeldungen" }
        ],
        linkText: "Ganze Fallstudie lesen"
    }
];
---

<section class="py-24 bg-[#0d0101] relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center mb-16">
            <h2
                class="text-3xl md:text-5xl font-heading font-bold text-white mb-6 leading-[1.1]"
                set:html={headline}
            >
            </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
            {cases.map((caseItem: any) => (
                <div class="group relative bg-slate-900 border border-white/5 rounded-3xl overflow-hidden hover:border-brand-primary/20 transition-all duration-300 hover:shadow-[0_0_30px_-10px_rgba(255,88,0,0.15)]">
                    <!-- Image Area -->
                    <div class="aspect-video bg-gradient-to-br from-slate-800 to-slate-950 relative overflow-hidden">
                        {caseItem.imageUrl ? (
                            <img src={caseItem.imageUrl} alt={caseItem.title} class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-500" />
                        ) : (
                            <>
                                <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
                                <div class="absolute inset-0 flex items-center justify-center text-slate-500 font-medium bg-black/20 backdrop-blur-sm">
                                    [Foto: {caseItem.title}]
                                </div>
                            </>
                        )}
                        <!-- Badge -->
                        {caseItem.badge && (
                            <div class="absolute top-4 left-4 bg-brand-dark/90 backdrop-blur border border-white/10 px-3 py-1 rounded-full text-xs font-bold text-brand-primary uppercase tracking-wider">
                                {caseItem.badge}
                            </div>
                        )}
                    </div>

                    <div class="p-8">
                        <h3 class="text-2xl font-heading font-bold text-white mb-2">
                            {caseItem.title}
                        </h3>
                        <div class="flex flex-col gap-6">
                            <div class="space-y-4">
                                <div class="flex gap-3">
                                    <div class="w-1 bg-red-500/50 rounded-full h-auto"></div>
                                    <div>
                                        <div class="text-xs text-slate-500 font-bold uppercase mb-1">Challenge</div>
                                        <p class="text-slate-300 text-sm">
                                            {caseItem.challenge}
                                        </p>
                                    </div>
                                </div>
                                <div class="flex gap-3">
                                    <div class="w-1 bg-green-500/50 rounded-full h-auto"></div>
                                    <div>
                                        <div class="text-xs text-slate-500 font-bold uppercase mb-1">Lösung</div>
                                        <p class="text-slate-300 text-sm">
                                            {caseItem.solution}
                                        </p>
                                    </div>
                                </div>
                            </div>

                            {caseItem.metrics && caseItem.metrics.length > 0 && (
                                <div class="grid grid-cols-2 gap-4 pt-6 border-t border-white/5">
                                    {caseItem.metrics.map((metric: any) => (
                                        <div>
                                            <div class="text-3xl font-heading font-bold text-brand-primary mb-1">
                                                {metric.value}
                                            </div>
                                            <div class="text-xs text-slate-400 font-medium" set:html={metric.label}>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            )}

                            {caseItem.linkText && (
                                <a
                                    href="#"
                                    class="inline-flex items-center text-brand-primary text-sm font-bold hover:text-white transition-colors mt-2 group-hover:translate-x-1 duration-300"
                                >
                                    {caseItem.linkText}
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="2"
                                        stroke="currentColor"
                                        class="size-4 ml-1"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                                        ></path>
                                    </svg>
                                </a>
                            )}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
