---
// ExpertiseGrid.astro
interface Props {
    data?: any;
}

const { data } = Astro.props;

// Fallback Content
const headline =
    data?.headline ||
    "Lokale Expertise trifft auf einen Mitarbeiter, der nie schläft.";
const imageUrl =
    data?.imageUrl ||
    "https://images.unsplash.com/photo-1611162617474-5b21e879e113?q=80&w=1600&auto=format&fit=crop";

const contentBlocks = data?.contentBlocks?.length
    ? data.contentBlocks
    : [
          {
              leadIn: "Echte Handelserfahrung statt Theorie.",
              text: "Wir kommen selbst aus dem stationären Handel und wissen genau, was an der Kasse zählt. Unsere maßgeschneiderten Marketing-Tools ersetzen teure Agenturen und fehleranfällige Freelancer komplett – mit Systemen, die dein Tagesgeschäft nicht blockieren, sondern erleichtern.",
          },
          {
              leadIn: "Immer im Einsatzmodus.",
              text: "Mit modernster, skalierbarer KI automatisieren wir Prozesse von der Bilderstellung bis zur Kundenkommunikation. Das bedeutet für dich: Messbare Ladenbesuche und Umsatz auf Autopilot, während du dich auf deine Kunden konzentrierst.",
          },
      ];
---

<section class="py-32 bg-[#000000] relative overflow-hidden">
    <!-- Subtle Background Glow (mimicking the purple glow on the left of the screenshot) -->
    <div
        class="absolute top-1/2 -left-1/4 -translate-y-1/2 w-[600px] h-[600px] bg-fuchsia-900/20 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-12 relative z-10">
        <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 items-center"
        >
            <!-- Left: Image (Phone/Device) -->
            <div
                class="relative w-full aspect-[3/4] md:aspect-square lg:aspect-[4/5] flex justify-center items-center"
            >
                <img
                    src={imageUrl}
                    alt={headline}
                    class="w-full h-full object-cover rounded-[2.5rem] shadow-2xl"
                    loading="lazy"
                    style="mask-image: linear-gradient(to bottom, black 80%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);"
                />
            </div>

            <!-- Right: Text Content (Screenshot Style) -->
            <div class="space-y-12 lg:pr-8">
                <!-- Headline: Large, entirely white, matching screenshot typography style -->
                <h2
                    class="text-4xl md:text-6xl font-bold text-white leading-[1.1] tracking-tight"
                >
                    {headline}
                </h2>

                <div class="space-y-8">
                    {
                        contentBlocks.map((block: any) => (
                            <p class="text-lg md:text-xl text-[#9CA3AF] leading-relaxed font-light">
                                {block.leadIn && (
                                    <strong class="text-white font-medium mr-1">
                                        {block.leadIn}
                                    </strong>
                                )}
                                {block.text}
                            </p>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
