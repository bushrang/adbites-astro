---
import { sanityClient } from "sanity:client";
import { GROQ_ORGANIZATION } from "../lib/sanityQueries";

const organization = await sanityClient.fetch(GROQ_ORGANIZATION);
const currentYear = new Date().getFullYear();

const { name, contactPoints, sameAs } = organization || {};
const email =
    contactPoints?.find((cp: any) => cp.contactType === "Email")?.email ||
    "hello@adbites.com";
---

<footer
    class="bg-transparent border-t border-white/5 pt-16 pb-8 relative overflow-hidden"
>
    <!-- Glow Effect -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-brand-primary/5 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div
            class="flex flex-col md:flex-row justify-between items-start gap-12 mb-16"
        >
            <!-- Brand -->
            <div class="max-w-xs">
                <div class="flex items-center gap-2 mb-6">
                    <img
                        src="/assets/images/adbites_logo_white.png"
                        alt="Adbites Logo"
                        class="h-8 w-auto"
                    />
                </div>
                <p class="text-slate-400 text-sm leading-relaxed mb-6">
                    {
                        organization?.description ||
                            "Wir helfen dem stationären Einzelhandel, im digitalen Zeitalter nicht nur zu überleben, sondern zu dominieren."
                    }
                </p>
            </div>

            <!-- Quick Links -->
            <div
                class="grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-16 w-full md:w-auto"
            >
                <div>
                    <h4 class="text-white font-bold mb-6">Agentur</h4>
                    <ul class="space-y-4 text-sm text-slate-400">
                        <li>
                            <a
                                href="#about"
                                class="hover:text-brand-primary transition-colors"
                                >Über Uns</a
                            >
                        </li>
                        <li>
                            <a
                                href="#services"
                                class="hover:text-brand-primary transition-colors"
                                >Produkte</a
                            >
                        </li>
                        <li>
                            <a
                                href="#cases"
                                class="hover:text-brand-primary transition-colors"
                                >Referenzen</a
                            >
                        </li>
                        <li>
                            <a
                                href="/kontakt"
                                class="hover:text-brand-primary transition-colors"
                                >Kontakt</a
                            >
                        </li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold mb-6">Kontakt</h4>
                    <ul class="space-y-4 text-sm text-slate-400">
                        {
                            organization?.address && (
                                <li>
                                    {organization.address.streetAddress}
                                    <br />
                                    {organization.address.postalCode}{" "}
                                    {organization.address.addressLocality}
                                    <br />
                                    {organization.address.addressCountry}
                                </li>
                            )
                        }
                        {
                            email && (
                                <li>
                                    <a
                                        href={`mailto:${email}`}
                                        class="text-brand-primary hover:text-white transition-colors"
                                    >
                                        {email}
                                    </a>
                                </li>
                            )
                        }
                        <li>
                            <a
                                href="/impressum"
                                class="hover:text-brand-primary transition-colors"
                                >Impressum</a
                            >
                        </li>
                        <li>
                            <a
                                href="/datenschutz"
                                class="hover:text-brand-primary transition-colors"
                                >Datenschutz</a
                            >
                        </li>
                    </ul>
                </div>
                {sameAs && sameAs.filter((url: string) => url.match(/facebook|instagram|linkedin|x\.com|twitter|youtube/i)).length > 0 && (
                    <div>
                        <h4 class="text-white font-bold mb-6">Socials</h4>
                        <div class="flex gap-4">
                            {sameAs
                                .filter((url: string) => url.match(/facebook|instagram|linkedin|x\.com|twitter|youtube/i))
                                .map((url: string) => {
                                let IconPath = `<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>`;
                                if (url.includes("linkedin")) IconPath = `<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>`;
                                if (url.includes("instagram")) IconPath = `<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />`;
                                if (url.includes("facebook")) IconPath = `<path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" />`;
                                if (url.includes("x.com") || url.includes("twitter")) IconPath = `<path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/>`;
                                if (url.includes("youtube")) IconPath = `<path fill-rule="evenodd" d="M19.812 5.418c.861.23 1.538.907 1.768 1.768C21.998 8.746 22 12 22 12s0 3.255-.418 4.814a2.504 2.504 0 0 1-1.768 1.768c-1.56.419-7.814.419-7.814.419s-6.255 0-7.814-.419a2.505 2.505 0 0 1-1.768-1.768C2 15.255 2 12 2 12s0-3.255.417-4.814a2.507 2.507 0 0 1 1.768-1.768C5.744 5 11.998 5 11.998 5s6.255 0 7.814.418ZM15.194 12 10 15V9l5.194 3Z" clip-rule="evenodd"/>`;
                                
                                return (
                                    <a
                                        href={url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-slate-400 hover:text-brand-primary transition-colors p-2 -ml-2 rounded-full hover:bg-brand-primary/10 flex-shrink-0"
                                        aria-label="Social Media Link"
                                    >
                                        <svg class="w-5 h-5" fill="currentColor" stroke={IconPath.includes("stroke") ? "currentColor" : "none"} viewBox="0 0 24 24" set:html={IconPath} />
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                )}
            </div>
        </div>

        <div
            class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-slate-500"
        >
            <p>
                &copy; {currentYear}
                {name || "Adbites Astro"}. All rights reserved.
            </p>
            <p>
                Designed with <span class="text-brand-primary">♥</span> in Germany.
            </p>
        </div>
    </div>
</footer>
