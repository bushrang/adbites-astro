---
interface Props {
    data?: {
        headline?: string;
        subline?: string;
    };
}

const { data } = Astro.props;

const headline = data?.headline || "Dein Marketing Ökosystem gegen jede Krise";
const subline =
    data?.subline ||
    "Wir bieten dem stationären Handel genau die Tools, die er braucht, um im digitalen Wettbewerb zu bestehen. Adbites macht Agenturen und Freelancer für dein Marketing überflüssig. Wir bieten dir ein komplettes Marketing Ökosystem an, das dir dabei hilft, deine Marketingstrategie effektiv zu implementieren.";
---

<section class="py-24 bg-transparent px-4 relative overflow-visible">
    <div class="max-w-4xl mx-auto text-center z-10 relative">
        <h2
            class="text-4xl md:text-6xl font-bold text-white mb-8 tracking-tight leading-[1.1]"
        >
            {headline}
        </h2>
        <p
            class="text-lg md:text-xl text-slate-300 leading-relaxed max-w-2xl mx-auto"
        >
            {subline}
        </p>
    </div>

    <!-- Subtle Background Glow -->
    <div
        class="absolute top-[60%] left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-brand-primary/5 rounded-full blur-[140px] pointer-events-none z-0"
    >
    </div>
</section>
