---
interface Props {
    headline: string;
    connections: string[];
    visual?: string; // Optional image URL
}

const { headline, connections, visual } = Astro.props;
---
<section class="py-24 bg-[#111] px-4 border-t border-white/5 relative overflow-hidden">
    <!-- Glows -->
    <div class="absolute -left-1/4 bottom-0 w-[40rem] h-[40rem] bg-blue-600/10 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-6 leading-[1.1]">
                {headline}
            </h2>
        </div>

        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
            <!-- Visual Representation -->
            <div class="w-full lg:w-1/2">
                {visual ? (
                    <img src={visual} alt="Adbites Ecosystem" class="w-full h-auto rounded-3xl" />
                ) : (
                    // Fallback CSS Mockup of Ecosystem
                    <div class="relative w-full aspect-square md:aspect-[4/3] rounded-3xl bg-transparent border border-white/10 p-8 flex items-center justify-center overflow-hidden shadow-2xl">
                         <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:40px_40px]"></div>
                        
                         <!-- Center Node -->
                         <div class="relative z-10 w-24 h-24 rounded-2xl bg-brand-primary/20 border border-brand-primary/50 flex items-center justify-center shadow-[0_0_30px_rgba(249,115,22,0.4)]">
                            <span class="text-brand-primary font-bold">Adbites</span>
                         </div>

                         <!-- Connecting lines and orbiting nodes mockup -->
                         <div class="absolute inset-0 z-0 flex items-center justify-center">
                            <div class="w-[60%] h-[60%] border border-dashed border-white/20 rounded-full animate-[spin_60s_linear_infinite]"></div>
                         </div>
                    </div>
                )}
            </div>

            <!-- Connections List -->
            <div class="w-full lg:w-1/2 flex flex-col gap-6">
                {connections.map((connection) => (
                    <div class="flex items-start gap-4 bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
                        <div class="shrink-0 w-10 h-10 rounded-full bg-brand-primary/20 flex items-center justify-center text-brand-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                            </svg>
                        </div>
                        <p class="text-slate-300 leading-relaxed text-lg">
                            {connection}
                        </p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>
