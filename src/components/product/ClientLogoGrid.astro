---
interface Props {
    data: {
        headline?: string;
        subline?: string;
        logos?: {
            imageUrl: string;
            altText?: string;
        }[];
    };
}

const { data } = Astro.props;

if (!data || !data.logos || data.logos.length === 0) {
    return null;
}
---

<section class="py-24 bg-transparent px-4 relative z-20">
    <div class="max-w-6xl mx-auto text-center relative">
        
        {data.headline && (
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-4 tracking-tight drop-shadow-md">
                {data.headline}
            </h2>
        )}
        
        {data.subline && (
            <p class="text-lg md:text-xl text-slate-300 font-light max-w-2xl mx-auto mb-16">
                {data.subline}
            </p>
        )}

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-8 md:gap-12 items-center justify-center auto-rows-[100px]">
            {data.logos.map((logo) => (
                <div class="flex items-center justify-center w-full h-full p-6 sm:p-8 opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500 ease-in-out cursor-default transform hover:scale-105">
                    <img 
                        src={logo.imageUrl} 
                        alt={logo.altText || "Client Logo"} 
                        loading="lazy" 
                        class="max-w-full max-h-full object-contain drop-shadow-md"
                    />
                </div>
            ))}
        </div>
        
    </div>
</section>
