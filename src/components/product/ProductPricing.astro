---
interface Props {
    headline: string;
    teaser: string;
    cta: { text: string; url: string };
    roiHint?: string;
}

const { headline, teaser, cta, roiHint } = Astro.props;
---

<section class="py-24 bg-transparent px-4 relative">
    <div
        class="max-w-4xl mx-auto bg-gradient-to-br from-white/[0.05] to-transparent border border-white/10 rounded-[2rem] p-10 md:p-16 text-center shadow-2xl relative overflow-hidden"
    >
        <!-- Gloss effect -->
        <div
            class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 bg-brand-primary/20 rounded-full blur-[80px] pointer-events-none"
        >
        </div>

        <h2
            class="text-3xl md:text-5xl font-heading font-bold text-white mb-6 leading-[1.1] relative z-10"
        >
            {headline}
        </h2>

        <div
            class="text-2xl md:text-3xl font-bold text-brand-primary mb-8 relative z-10"
        >
            {teaser}
        </div>

        {
            roiHint && (
                <div class="inline-block bg-white/5 border border-white/10 rounded-full px-6 py-2 text-slate-300 text-sm mb-10 relative z-10 shadow-inner">
                    <span class="mr-2">💡</span> {roiHint}
                </div>
            )
        }

        <div class="relative z-10">
            <a
                href={cta.url}
                class="inline-flex justify-center items-center px-8 py-4 rounded-full bg-white text-[#111] font-bold hover:bg-slate-200 transition-colors shadow-[0_0_20px_rgba(255,255,255,0.2)] text-lg group"
            >
                {cta.text}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
                </svg>
            </a>
        </div>
    </div>
</section>
