---
interface CardData {
    title?: string;
    price?: string;
    features?: string[];
}

interface Props {
    data?: {
        headline?: string;
        subline?: string;
        freelancerCard?: CardData;
        agencyCard?: CardData;
        adbitesCard?: CardData & { badge?: string };
    };
}

const { data } = Astro.props;

// Only render the section if actual comparison features have been entered in the CMS
const hasFeatures = 
    (data?.freelancerCard?.features?.length ?? 0) > 0 || 
    (data?.adbitesCard?.features?.length ?? 0) > 0 || 
    (data?.agencyCard?.features?.length ?? 0) > 0;

if (!data || !hasFeatures) return null;
---

<section class="py-24 relative z-10 overflow-hidden bg-slate-950">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-slate-900 via-transparent to-transparent opacity-50 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            {data.headline && (
                <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-6">
                    {data.headline}
                </h2>
            )}
            {data.subline && (
                <p class="text-slate-400 text-lg">
                    {data.subline}
                </p>
            )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center max-w-5xl mx-auto">
            {/* Freelancer Card */}
            {data.freelancerCard && (
                <div class="bg-white/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 flex flex-col h-auto md:h-[420px]">
                    <h3 class="text-xl font-bold text-white mb-2">{data.freelancerCard.title}</h3>
                    <p class="text-slate-400 font-mono text-sm mb-8 pb-4 border-b border-white/10">{data.freelancerCard.price}</p>
                    <ul class="space-y-4">
                        {data.freelancerCard.features?.map((feature) => (
                            <li class="flex items-start gap-3 text-slate-300">
                                <svg class="w-5 h-5 text-red-500/80 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                <span class="text-sm leading-tight">{feature}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            )}

            {/* Adbites Card (Highlighted) */}
            {data.adbitesCard && (
                <div class="relative bg-slate-900 rounded-3xl p-10 border-2 border-brand-primary shadow-[0_0_40px_rgba(255,107,0,0.25)] flex flex-col h-auto md:h-[480px] transform md:-translate-y-4 z-10">
                    <div class="absolute inset-0 bg-gradient-to-b from-brand-primary/10 to-transparent rounded-[1.8rem] pointer-events-none"></div>
                    
                    {data.adbitesCard.badge && (
                        <span class="absolute -top-4 left-1/2 -translate-x-1/2 bg-brand-primary text-white text-xs font-bold uppercase tracking-wider py-1.5 px-4 rounded-full shadow-lg whitespace-nowrap">
                            {data.adbitesCard.badge}
                        </span>
                    )}
                    
                    <h3 class="text-2xl font-bold text-white mb-2 relative z-10">{data.adbitesCard.title}</h3>
                    <p class="text-brand-primary font-mono font-bold mb-8 pb-4 border-b border-white/10 relative z-10">{data.adbitesCard.price}</p>
                    
                    <ul class="space-y-5 relative z-10">
                        {data.adbitesCard.features?.map((feature) => (
                            <li class="flex items-start gap-3 text-white font-medium">
                                <svg class="w-6 h-6 text-brand-primary shrink-0" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                </svg>
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            )}

            {/* Agency Card */}
            {data.agencyCard && (
                <div class="bg-white/5 backdrop-blur-md rounded-3xl p-8 border border-white/10 flex flex-col h-auto md:h-[420px]">
                    <h3 class="text-xl font-bold text-white mb-2">{data.agencyCard.title}</h3>
                    <p class="text-slate-400 font-mono text-sm mb-8 pb-4 border-b border-white/10">{data.agencyCard.price}</p>
                    <ul class="space-y-4">
                        {data.agencyCard.features?.map((feature) => (
                            <li class="flex items-start gap-3 text-slate-300">
                                <svg class="w-5 h-5 text-red-500/80 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                <span class="text-sm leading-tight">{feature}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            )}
        </div>
    </div>
</section>
