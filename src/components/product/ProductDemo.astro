---
interface Props {
    headline?: string;
    description: string;
    mediaOption: 'slider' | 'video' | 'image';
    mediaSource: any; // e.g. { before: string, after: string } or URL string
    cta?: { text: string; url: string; };
}

const { headline, description, mediaOption, mediaSource, cta } = Astro.props;
---
<section class="py-24 bg-[#0d0101] px-4 relative">
    <!-- Subtle glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40rem] h-[40rem] bg-brand-primary/5 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto text-center relative z-10">
        {headline && (
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-6 leading-[1.1]">
                {headline}
            </h2>
        )}
        <p class="text-lg md:text-xl text-slate-400 mb-12 max-w-2xl mx-auto leading-relaxed">
            {description}
        </p>

        <!-- Media Display -->
        <div class="relative w-full rounded-[2rem] border border-white/10 overflow-hidden shadow-2xl bg-[#111] mb-12 aspect-[16/10] md:aspect-[21/9]">
            {mediaOption === 'slider' && mediaSource.before && mediaSource.after ? (
                <div class="relative w-full h-full flex group/slider cursor-ew-resize">
                    <div class="w-1/2 h-full relative border-r-2 border-brand-primary overflow-hidden">
                        <img src={mediaSource.before} class="absolute inset-0 w-[200%] max-w-none h-full object-cover" alt="Vorher" />
                        <div class="absolute top-4 left-4 bg-black/60 backdrop-blur-md px-4 py-1.5 rounded-full text-white text-xs font-bold uppercase tracking-wider">Vorher</div>
                    </div>
                    <div class="w-1/2 h-full relative overflow-hidden">
                        <img src={mediaSource.after} class="absolute inset-0 -left-[100%] w-[200%] max-w-none h-full object-cover" alt="Nachher" />
                        <div class="absolute top-4 right-4 bg-brand-primary/90 backdrop-blur-md px-4 py-1.5 rounded-full text-white text-xs font-bold uppercase tracking-wider shadow-[0_0_15px_rgba(249,115,22,0.5)]">Nachher</div>
                    </div>
                    <!-- Slider Handle Mock -->
                    <div class="absolute top-0 bottom-0 left-1/2 -translate-x-1/2 w-8 py-4 flex flex-col items-center justify-center pointer-events-none">
                        <div class="w-12 h-12 bg-white rounded-full shadow-[0_0_15px_rgba(0,0,0,0.5)] flex items-center justify-center text-slate-800 transition-transform group-hover/slider:scale-110">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6">
                              <path fill-rule="evenodd" d="M12.207 2.232a.75.75 0 0 0 .025 1.06l4.146 3.958H2.75a.75.75 0 0 0 0 1.5h13.628l-4.146 3.957a.75.75 0 1 0 1.036 1.085l5.5-5.25a.75.75 0 0 0 0-1.085l-5.5-5.25a.75.75 0 0 0-1.06.025Z" clip-rule="evenodd" />
                              <path fill-rule="evenodd" d="M7.793 17.768a.75.75 0 0 0-.025-1.06L3.622 12.75h13.628a.75.75 0 0 0 0-1.5H3.622l4.146-3.957a.75.75 0 0 0-1.036-1.085l-5.5 5.25a.75.75 0 0 0 0 1.085l5.5 5.25a.75.75 0 0 0 1.06-.025Z" clip-rule="evenodd" />
                            </svg>
                        </div>
                    </div>
                </div>
            ) : mediaOption === 'video' ? (
                <div class="w-full h-full bg-slate-800 flex items-center justify-center">
                    <span class="text-slate-500">Video Player Placeholder</span>
                </div>
            ) : (
                <img src={mediaSource} alt="Demo" class="w-full h-full object-cover" />
            )}
        </div>

        {cta && (
            <div class="flex justify-center">
                <a href={cta.url} class="inline-flex justify-center items-center px-8 py-4 rounded-full bg-brand-primary text-white font-bold hover:bg-orange-600 transition-colors shadow-[0_0_20px_rgba(249,115,22,0.3)] text-lg">
                    {cta.text}
                </a>
            </div>
        )}
    </div>
</section>
