---
import SocialFanOut from "./SocialFanOut.jsx";
import VideoGalleryCarousel from "./VideoGalleryCarousel.jsx";

interface Props {
    data?: {
        designType?: string;
         সামাজিকFanOutData?: any; // To be mapped nicely from GROQ
        socialFanOutData?: any;
        videoGalleryData?: any;
    };
}

const { data } = Astro.props;

if (!data || !data.designType) return null;
---

{data.designType === 'design-1-social-fan-out' && data.socialFanOutData && (
    <SocialFanOut client:visible data={data.socialFanOutData} />
)}

{data.designType === 'design-2-video-gallery' && data.videoGalleryData && (
    <VideoGalleryCarousel client:visible data={data.videoGalleryData} />
)}

{data.designType === 'design-3' && (
    <div class="py-24 text-center text-slate-400 bg-transparent">
        <h2 class="text-3xl font-bold mb-4">VisualSection (Design 3 Placeholder)</h2>
        <p>This design type has not been implemented yet.</p>
    </div>
)}
