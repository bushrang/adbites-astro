---
interface Props {
  data?: {
    headline?: string;
    subline?: string;
    image?: string;
    primaryButtonText?: string;
    primaryButtonUrl?: string;
    trustLogos?: string[];
  };
}

const { data } = Astro.props;
---

<section class="min-h-screen flex items-center justify-center bg-transparent relative pt-32 pb-20">
  <div
    class="absolute inset-0 z-0 opacity-20 pointer-events-none mix-blend-overlay"
    style="background-image: url('/noise.svg');"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 grid md:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
    <!-- Left: Content -->
    <div class="animate-fade-in-up md:col-span-1 lg:col-span-6">
      
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-white mb-6 leading-[1.1] drop-shadow-2xl">
        {data?.headline || "Das Produkt"}
      </h1>
      
      <p class="text-lg text-slate-300 leading-relaxed font-light mb-10 max-w-lg">
        {data?.subline || "Die perfekte Lösung für dein lokales Unternehmen."}
      </p>

      {data?.primaryButtonText && data?.primaryButtonUrl && (
        <a href={data.primaryButtonUrl} class="glow-border-btn max-sm:w-full">
          <span class="glow-border-inner flex justify-center w-full">{data.primaryButtonText}</span>
        </a>
      )}

      {data?.trustLogos && data.trustLogos.length > 0 && (
        <div class="mt-8 flex flex-wrap items-center gap-6 opacity-80">
          {data.trustLogos.map((logoUrl) => (
             <img src={logoUrl} alt="Platform / Trust Icon" class="h-6 w-auto object-contain grayscale hover:grayscale-0 transition-all duration-300" />
          ))}
        </div>
      )}
    </div>

    <!-- Right: Image -->
    <div class="animate-fade-in-up delay-200 relative md:col-span-1 lg:col-span-6 -my-16 -mr-16 z-20">
      <div class="absolute -inset-10 bg-[#FF6B00]/20 rounded-full blur-3xl pointer-events-none"></div>
      {data?.image ? (
        <img
          src={data.image}
          alt={data?.headline || "Product"}
          class="relative w-full h-auto object-cover rounded-2xl drop-shadow-2xl animate-hero-image-fx"
        />
      ) : null}
    </div>
  </div>
</section>

<style>
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  .delay-200 { animation-delay: 0.2s; }
  
  @keyframes fadeInUp {
    to { opacity: 1; transform: translateY(0); }
  }

  .glow-border-btn {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    padding: 1px; border-radius: 10px; text-decoration: none;
    background-image: conic-gradient(
      from var(--angle, 0deg), transparent 55%, rgba(160, 80, 20, 0.5) 68%,
      rgba(220, 120, 20, 0.85) 74%, rgba(255, 200, 60, 0.9) 78%,
      rgba(80, 200, 255, 0.7) 84%, rgba(100, 80, 220, 0.5) 90%, transparent 100%
    );
    animation: rotateBorder 4s linear infinite; transition: opacity 0.3s;
  }
  .glow-border-btn::before {
    content: ""; position: absolute; inset: -2px; border-radius: 12px;
    background-image: conic-gradient(
      from var(--angle, 0deg), transparent 55%, rgba(160, 80, 20, 0.2) 68%,
      rgba(220, 120, 20, 0.4) 74%, rgba(255, 200, 60, 0.35) 78%,
      rgba(80, 200, 255, 0.25) 84%, rgba(100, 80, 220, 0.2) 90%, transparent 100%
    );
    filter: blur(6px); z-index: -1; animation: rotateBorder 4s linear infinite;
  }
  .glow-border-btn:hover { opacity: 0.85; }
  .glow-border-inner {
    position: relative; display: flex; background: #0c1628; border-radius: 9px;
    padding: 1rem 2rem; color: #94a3b8; font-family: 'Inter', sans-serif;
    font-weight: 600; font-size: 1.05rem; letter-spacing: 0.02em; white-space: nowrap;
    z-index: 1; transition: color 0.3s, background 0.3s;
  }
  .glow-border-btn:hover .glow-border-inner {
    background: #111f38; color: #e2e8f0;
  }
  @property --angle { syntax: "<angle>"; initial-value: 0deg; inherits: false; }
  @keyframes rotateBorder { to { --angle: 360deg; } }
  
  .animate-hero-image-fx {
    animation: blurSharp 1.2s ease-out 0.2s both, floating 6s ease-in-out 1.4s infinite;
  }
  @keyframes blurSharp {
    0% { filter: blur(20px); opacity: 0; transform: scale(0.95); }
    100% { filter: blur(0px); opacity: 1; transform: scale(1); }
  }
  @keyframes floating {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-15px) scale(1); }
  }
</style>
