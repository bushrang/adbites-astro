---
import { PortableText } from "astro-portabletext";

interface Feature {
    badge?: string;
    headline?: string;
    text?: any;
    image?: string;
    buttonText?: string;
    buttonUrl?: string;
}

interface Props {
    features: Feature[];
}

const { features = [] } = Astro.props;
---

<section class="py-24 bg-transparent relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-32 relative z-10">
        {features.map((feature, idx) => (
            <div class={`grid md:grid-cols-2 gap-12 lg:gap-20 items-center ${idx % 2 !== 0 ? 'md:grid-flow-col-dense' : ''}`}>
               <!-- Text Content -->
               <div class={`space-y-6 ${idx % 2 !== 0 ? 'md:col-start-2' : ''}`}>
                  {feature.badge && (
                      <span class="inline-block px-3 py-1 rounded-full border border-brand-primary/20 bg-brand-primary/5 text-brand-primary text-xs font-bold tracking-widest uppercase mb-2">
                          {feature.badge}
                      </span>
                  )}
                  <h3 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold text-white leading-[1.1]">
                      {feature.headline}
                  </h3>
                  <div class="prose prose-invert prose-p:text-lg prose-p:text-slate-400 prose-p:leading-relaxed prose-a:text-brand-primary max-w-lg mb-6">
                      {typeof feature.text === 'string' ? (
                          <p>{feature.text}</p>
                      ) : (
                          feature.text && <PortableText value={feature.text} />
                      )}
                  </div>
                  
                  {feature.buttonText && feature.buttonUrl && (
                      <div class="pt-4">
                          <a href={feature.buttonUrl} class="inline-flex items-center text-brand-primary font-bold hover:text-white transition-colors group">
                              {feature.buttonText}
                              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                              </svg>
                          </a>
                      </div>
                  )}
               </div>

               <!-- Image Content -->
               <div class={`relative ${idx % 2 !== 0 ? 'md:col-start-1' : ''}`}>
                   {idx % 2 !== 0 && (
                       <div class="absolute -inset-6 bg-[#FF6B00]/20 rounded-full blur-3xl pointer-events-none"></div>
                   )}
                   {feature.image ? (
                       <img src={feature.image} alt={feature.headline} class="relative w-full h-auto object-cover rounded-2xl" />
                   ) : <span class="text-slate-600">[Placeholder]</span>}
               </div>
            </div>
        ))}
    </div>
</section>
